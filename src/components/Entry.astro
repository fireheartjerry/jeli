---
/**
 * One thing done: its name, the role and when, and a line on what it was.
 * No more than that; the detail lives behind the link.
 */
interface Props {
  title: string;
  href?: string;
  role?: string;
  period?: string;
}
const { title, href, role, period } = Astro.props;
// Links within the site stay in this tab.
const external = !!href && /^https?:/.test(href);
---

<article class="entry" data-reveal="entry">
  <div class="text">
    <h3>
      {href ? <a class="ln" href={href} target={external ? "_blank" : undefined} rel={external ? "noopener" : undefined}>{title}</a> : title}
    </h3>
    <p class="meta">
      {role && <span>{role}</span>}
      {period && <span class="num">{period}</span>}
    </p>
    <div class="body"><slot /></div>
  </div>
</article>

<style>
  .entry {
    padding-block: 22px;
  }
  h3 {
    font-size: 21px;
    line-height: 1.25;
    letter-spacing: -0.012em;
  }
  h3 a {
    padding-block: 8px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.9em;
    margin-top: 4px;
    font-size: 14.5px;
    color: var(--ink-3);
  }
  .body {
    margin-top: 10px;
    color: var(--ink-2);
    max-width: 44ch;
  }
  .body :global(p + p) {
    margin-top: 0.6em;
  }
  .body :global(a.ln) {
    padding-block: 10px;
  }
</style>
