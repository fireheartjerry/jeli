---
/**
 * One thing done: its name, the role and when, and a line on what it was.
 * No more than that; the detail lives behind the link.
 */
interface Props {
  title: string;
  href?: string;
  role?: string;
  period?: string;
}
const { title, href, role, period } = Astro.props;
// Links within the site stay in this tab.
const external = !!href && /^https?:/.test(href);
---

<article class="entry" data-reveal="entry">
  <div class="text">
    <h3>
      {href ? <a class="ln" href={href} target={external ? "_blank" : undefined} rel={external ? "noopener" : undefined}>{title}</a> : title}
      {external && (
        <svg class="out" viewBox="0 0 10 10" aria-hidden="true"><path d="M2.5 7.5 7.5 2.5M3.5 2.5h4v4" /></svg>
      )}
    </h3>
    <p class="meta">
      {role && <span>{role}</span>}
      {period && <span class="num">{period}</span>}
    </p>
    <div class="body"><slot /></div>
  </div>
</article>

<style>
  .entry {
    padding-block: 22px;
  }
  /* Set like a CV: the name and the years on one line, the role under the name. */
  .text {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 20px;
  }
  .text > h3 {
    grid-column: 1;
    grid-row: 1;
  }
  .meta {
    display: contents;
  }
  .meta > span:not(.num) {
    grid-column: 1;
    grid-row: 2;
    margin-top: 2px;
  }
  .meta > .num {
    grid-column: 2;
    grid-row: 1;
    align-self: baseline;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .body {
    grid-column: 1 / -1;
  }
  /* A link that leaves the site says so, and leans the way it goes under the pointer. */
  .out {
    display: inline-block;
    width: 9px;
    height: 9px;
    margin-left: 6px;
    vertical-align: 0.12em;
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      translate var(--t-press) var(--ease-io),
      stroke var(--t-press) var(--ease-io);
  }
  h3:hover .out {
    translate: 1.5px -1.5px;
    stroke: var(--accent);
  }
  h3 {
    font-size: 21px;
    line-height: 1.25;
    letter-spacing: -0.012em;
  }
  h3 a {
    padding-block: 8px;
  }
  .meta > span {
    font-size: 14.5px;
    color: var(--ink-3);
  }
  .body {
    margin-top: 10px;
    color: var(--ink-2);
    max-width: 44ch;
  }
  .body :global(p + p) {
    margin-top: 0.6em;
  }
  .body :global(a.ln) {
    padding-block: 10px;
  }
</style>
