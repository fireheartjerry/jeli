---
/**
 * A figure plate. Every animated figure on the site sits in one of these:
 * a quiet white instrument panel with its number, a title, and an optional
 * live readout that the figure's script writes into ([data-readout]).
 *
 * Plot area is authored at viewBox width 640 so strokes render at the same
 * weight in every plate.
 */
interface Props {
  name: string;
  n: number;
  title: string;
  label: string;
  readout?: string;
  class?: string;
  /** "stage" plates span the full content width (flagship figures). */
  size?: "default" | "stage";
  /** Put the plot on an inset dot-grid surface with registration marks. */
  screen?: boolean;
}
const { name, n, title, label, readout = "", class: cls, size = "default", screen = false } = Astro.props;
---

<figure class:list={["fig", cls, { stage: size === "stage" }]} data-fig={name} data-reveal="plate" aria-label={label}>
  {/* The sheet: everything that is on the plate. It is one box so that it can be let out from the top as the plate is plotted. */}
  <div class="sheet">
    <header class="plate-h">
      <span class="led" aria-hidden="true"></span>
      <span class="n num">Fig. {n}</span>
      <span class="t">{title}</span>
      <span class="readout num" data-readout aria-hidden="true">{readout}</span>
    </header>
    <div class:list={["plot", { screen }]}><slot /></div>
    {Astro.slots.has("caption") && <figcaption><slot name="caption" /></figcaption>}
  </div>
  {/*
    The plate's edge as lines that can be drawn (scripts/reveal.ts); unseen
    without it. Two lines, each with a pen at its head: one runs clockwise from
    the status light, the other the opposite way down the left side. Last in
    the plate, so a figure's own "svg" is still the first one in it.
  */}
  <svg class="edge" aria-hidden="true">
    <rect class="line" data-edge="a" pathLength="1" /><rect class="line" data-edge="b" pathLength="1" />
    <rect class="pen" data-pen="a" pathLength="1" /><rect class="pen" data-pen="b" pathLength="1" />
    <line class="bar" data-bar x1="0" x2="100%" y1="0" y2="0" />
  </svg>
</figure>

<style>
  .fig {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--panel);
    border: 1px solid var(--hair);
    border-radius: 14px;
    box-shadow: var(--plate-shadow);
  }
  .sheet {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    padding: 18px 22px 20px;
    border-radius: inherit;
  }
  /* Plotted in: the border is the pair of lines in .edge, and the sheet is let out between them. */
  .edge {
    display: none;
    position: absolute;
    inset: -1px;
    width: calc(100% + 2px);
    height: calc(100% + 2px);
    overflow: visible;
    pointer-events: none;
    fill: none;
  }
  .edge rect {
    x: 0.5px;
    y: 0.5px;
    width: calc(100% - 1px);
    height: calc(100% - 1px);
    rx: 14px;
    stroke: var(--hair);
    stroke-width: 1px;
    stroke-dasharray: 0 1;
  }
  /* The bar the two pens ride on: a hairline across the plate at the height they have reached. */
  .edge .bar {
    stroke: var(--accent);
    stroke-width: 1px;
    opacity: 0;
  }
  /* A pen: a short bright stroke at the head of the line it is drawing. */
  .edge .pen {
    stroke: var(--accent);
    stroke-width: 1.5px;
    stroke-linecap: round;
    opacity: 0;
  }
  .fig[data-plate] {
    border-color: transparent;
    background: none;
    box-shadow: none;
  }
  .fig[data-plate] .edge {
    display: block;
  }
  .fig[data-plate] .sheet {
    background: var(--panel);
    box-shadow: var(--plate-shadow);
  }
  .plot {
    margin-bottom: 14px;
  }
  .plate-h {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 12.5px;
    color: var(--ink-3);
    margin-bottom: 14px;
  }
  .n {
    color: var(--ink);
    font-weight: 500;
  }
  /* Status light: dim at rest, lit while the figure is on stage. */
  .led {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink-4);
    align-self: center;
    transition: background-color var(--t-state) var(--ease-io);
  }
  .fig[data-running] .led {
    background: var(--accent);
  }
  /* Inset "screen": the plot sits on a faint dot grid with corner registration marks. */
  .plot.screen {
    position: relative;
    background-color: var(--panel-2);
    background-image: radial-gradient(circle at 1px 1px, var(--grid-dot) 1px, transparent 1.2px);
    background-size: 16px 16px;
    background-position: 8px 8px;
    border: 1px solid var(--hair);
    border-radius: 9px;
    padding: 14px;
  }
  .plot.screen::before,
  .plot.screen::after {
    content: "";
    position: absolute;
    width: 9px;
    height: 9px;
    border: 0 solid var(--ink-4);
    pointer-events: none;
  }
  .plot.screen::before { top: 6px; left: 6px; border-top-width: 1px; border-left-width: 1px; }
  .plot.screen::after { bottom: 6px; right: 6px; border-bottom-width: 1px; border-right-width: 1px; }
  .readout {
    margin-left: auto;
    font-family: var(--sans);
    font-variant-numeric: tabular-nums;
    font-size: 12.5px;
    color: var(--ink-2);
    white-space: pre;
    min-height: 1em;
  }
  .plot :global(svg),
  .plot :global(canvas) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  figcaption {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--hair);
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-3);
  }

  /* Series palette for multi-series figures. */
  .fig :global(.s-blue) { stroke: var(--s-blue); }
  .fig :global(.s-red) { stroke: var(--s-red); }
  .fig :global(.s-green) { stroke: var(--s-green); }
  .fig :global(.s-violet) { stroke: var(--s-violet); }
  .fig :global(.s-amber) { stroke: var(--s-amber); }
  .fig :global(.f-blue) { fill: var(--s-blue); }
  .fig :global(.f-red) { fill: var(--s-red); }
  .fig :global(.f-green) { fill: var(--s-green); }
  .fig :global(.f-violet) { fill: var(--s-violet); }
  .fig :global(.f-amber) { fill: var(--s-amber); }
  .fig :global(.t-blue) { fill: var(--s-blue-t); }
  .fig :global(.t-red) { fill: var(--s-red-t); }
  .fig :global(.t-green) { fill: var(--s-green-t); }
  .fig :global(.t-violet) { fill: var(--s-violet-t); }
  .fig :global(.t-amber) { fill: var(--s-amber-t); }
  .fig :global(.inset) { fill: var(--panel-2); stroke: var(--hair); }

  /* Shared figure vocabulary: every figure draws with the same few strokes. */
  .fig :global(.ink) { stroke: var(--ink); fill: none; stroke-width: 1.25; stroke-linecap: round; stroke-linejoin: round; }
  .fig :global(.faint) { stroke: var(--ink-4); fill: none; stroke-width: 1; stroke-linecap: round; }
  .fig :global(.hair) { stroke: var(--hair); fill: none; stroke-width: 1; }
  .fig :global(.dash) { stroke: var(--ink-3); fill: none; stroke-width: 1.25; stroke-dasharray: 3 4; }
  .fig :global(.accent) { stroke: var(--accent); fill: none; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .fig :global(.dot) { fill: var(--ink); }
  .fig :global(.dot-accent) { fill: var(--accent); }
  .fig :global(.fill-accent-soft) { fill: var(--accent-soft); }
  .fig :global(.paper) { fill: var(--panel); }
  .fig :global(text) { font-family: var(--sans); font-size: 11px; fill: var(--ink-3); letter-spacing: 0.01em; }
  .fig :global(text.m) { font-family: var(--math); font-style: italic; font-size: 14px; fill: var(--ink-2); letter-spacing: 0; }
  .fig :global(text.cm) { font-family: var(--cm); font-size: 12px; fill: var(--ink-3); letter-spacing: 0; }
  .fig :global(text.strong) { fill: var(--ink); }
  .fig :global(text.acc) { fill: var(--accent); }
  /* Plots are authored 640 wide; on phones they shrink ~2x, so labels grow to stay legible. */
  @media (max-width: 560px) {
    .fig { border-radius: 12px; }
    .sheet { padding: 14px 14px 16px; }
    .edge rect { rx: 12px; }
    /* Phones: the live readout drops to its own line so the title never wraps. */
    .plate-h { flex-wrap: wrap; row-gap: 2px; }
    /* min-width lets the line shrink to the plate: without it one long readout widens the whole page. */
    .readout { flex-basis: 100%; min-width: 0; margin-left: 16px; font-size: 12px; overflow: hidden; text-overflow: ellipsis; }
    .fig :global(text) { font-size: 19px; }
    .fig :global(text.m) { font-size: 22px; }
    .fig :global(text.cm) { font-size: 18px; }
  }
</style>
