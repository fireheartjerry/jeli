---
import CopyEmail from "./CopyEmail.astro";

interface Props {
  /** Figure number for the closing image. */
  n?: number;
}
const { n = 17 } = Astro.props;
// Bump when the content changes; a build timestamp would claim updates that never happened.
const updated = "October 2026";
---

{/* The page ends where it began, at night: the same system, with the sphere closed. */}
<footer id="contact" class="foot" data-night data-foot>
  <img class="end" src="/cover-end.webp" alt="" width="1600" height="1000" loading="lazy" decoding="async" data-end />
  <div class="wrap inner">
    <p class="cap">
      <span class="n num">Fig. {n}</span>
      The same system with the sphere closed: 60,000 collectors, and all of the Sun's output leaving
      through the pole.
    </p>
    <div class="big">
      <p class="k">Get in touch</p>
      <CopyEmail label="fireheartjerry@gmail.com" class="mail" />
      <p class="hint">Click to copy, or press <kbd>e</kbd> anywhere.</p>
    </div>
    <div class="meta">
      <p>Toronto and Waterloo, Canada</p>
      <nav aria-label="Elsewhere">
        <a class="q" href="/resume.pdf">Résumé</a>
        <a class="q" href="https://github.com/fireheartjerry" rel="me noopener" target="_blank">GitHub</a>
        <a class="q" href="https://www.linkedin.com/in/fireheartjerry/" rel="me noopener" target="_blank">LinkedIn</a>
        <a class="q" href="https://topsoj.com" target="_blank" rel="noopener">TopsOJ</a>
        <a class="q" href="https://waterloodefence.ca" target="_blank" rel="noopener">Waterloo Defence</a>
      </nav>
      <p class="num">Updated {updated}</p>
    </div>
  </div>
</footer>

<script>
  import { gsap, reducedMotion } from "../scripts/motion";

  // The closing image drifts a little against the scroll, and only then.
  const foot = document.querySelector<HTMLElement>("[data-foot]");
  const end = foot?.querySelector<HTMLElement>("[data-end]");
  if (foot && end && !reducedMotion()) {
    gsap.fromTo(end, { yPercent: -7 }, { yPercent: 5, ease: "none", scrollTrigger: { trigger: foot, start: "top bottom", end: "bottom bottom", scrub: 0.4 } });
  }
</script>

<style>
  .foot {
    position: relative;
    margin-top: clamp(96px, 12vw, 176px);
    background: var(--paper);
    color: var(--ink);
    overflow: clip;
    isolation: isolate;
  }
  .end {
    position: absolute;
    z-index: -1;
    right: 0;
    top: -6%;
    width: min(100%, 1500px);
    height: 112%;
    object-fit: cover;
    object-position: 68% 50%;
    /* Hold the left down so the type reads. */
    -webkit-mask-image: linear-gradient(90deg, transparent 4%, #000 58%);
    mask-image: linear-gradient(90deg, transparent 4%, #000 58%);
  }
  .inner {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: min(92svh, 860px);
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: 36px;
  }
  .cap {
    max-width: 300px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-3);
  }
  .cap .n {
    color: var(--ink);
    margin-right: 0.5em;
  }
  .big {
    align-self: end;
    padding-bottom: clamp(40px, 7vw, 88px);
  }
  .k {
    font-size: 15px;
    color: var(--ink-3);
    margin-bottom: 14px;
  }
  .big :global(.mail) {
    font-size: clamp(28px, 6.4vw, 96px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
    padding-block: 6px;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1.5px no-repeat;
    transition: background-size 0.6s var(--ease-out);
  }
  .big :global(.mail:hover) {
    background-size: 100% 1.5px;
  }
  .hint {
    margin-top: 16px;
    font-size: 15px;
    color: var(--ink-3);
  }
  @media (hover: none) {
    .hint {
      display: none;
    }
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 32px;
    padding-top: 14px;
    border-top: 1px solid var(--hair);
    font-size: 15px;
    color: var(--ink-3);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 22px;
  }
  .q {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    transition: color 0.2s ease;
  }
  .q:hover {
    color: var(--ink);
  }
  @media (max-width: 880px) {
    /* On a narrow screen the whole sphere sits under the caption, and the type under the sphere. */
    .end {
      width: 100%;
      height: 56%;
      top: 76px;
      object-position: 79% 50%;
      -webkit-mask-image: linear-gradient(transparent, #000 14%, #000 62%, transparent);
      mask-image: linear-gradient(transparent, #000 14%, #000 62%, transparent);
    }
    .inner {
      min-height: min(96svh, 760px);
    }
  }
</style>
