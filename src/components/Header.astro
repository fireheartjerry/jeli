---
import CopyEmail from "./CopyEmail.astro";
import { sections } from "../data/paper";

interface Props {
  /** The page opens on the night cover, so the bar starts in night colours and lies over it. */
  cover?: boolean;
  /** A fixed breadcrumb for pages that are not the home page. */
  crumb?: string;
}
const { cover = false, crumb } = Astro.props;
const home = Astro.url.pathname === "/";
const at = (id: string) => (home ? `#${id}` : `/#${id}`);

// The loupe on the index: fine graduations that show only round the mark, and
// only while it moves. Its outline is one raised cosine, REACH px either side
// of the mark and LONG px at its longest. (The script below uses the same reach.)
const REACH = 60;
const LONG = 6;
const edge = Array.from({ length: (2 * REACH) / 3 + 1 }, (_, i) => {
  const y = i * 3;
  return `${+(LONG * Math.cos((Math.PI * (y - REACH)) / (2 * REACH)) ** 2).toFixed(2)}px ${y}px`;
});
const loupe = `polygon(0 0, ${edge.join(", ")}, 0 ${2 * REACH}px)`;
---

<header class:list={["bar", { cover }]} data-bar data-night={cover ? "" : undefined}>
  <div class="wrap inner">
    <a class="name" href={home ? "#top" : "/"} aria-label={home ? "Jerry Li, back to top" : "Jerry Li, home"}>
      Jerry Li
      <span class="crumb" aria-hidden="true" data-on={crumb ? "" : undefined}>
        <span class="sep">/</span>
        <span class="track"><span class="cur" data-crumb>{crumb}</span><span class="next" data-crumb-next></span></span>
      </span>
    </a>
    {/* How far the camera behind the page is from the Sun; scripts/voyage.ts keeps it. Empty, and so unseen, without the scene. */}
    <span class="odo cm" data-odo aria-hidden="true"></span>
    <nav aria-label="Elsewhere">
      {/* A plain link's label rolls over under the pointer: .roll, in global.css. */}
      <a class="q" href="/resume.pdf"><span class="roll"><span>Résumé</span></span></a>
      <a class="q hide-sm" href="https://github.com/fireheartjerry" rel="me noopener" target="_blank"><span class="roll"><span>GitHub</span></span></a>
      <a class="q hide-sm" href="https://www.linkedin.com/in/fireheartjerry/" rel="me noopener" target="_blank"><span class="roll"><span>LinkedIn</span></span></a>
      <span class="q"><CopyEmail /></span>
      <button class="q cmd" type="button" data-palette-open aria-haspopup="dialog" aria-keyshortcuts="Meta+K Control+K" aria-label="Open the command palette">
        <span class="jump" data-jump>Jump</span><kbd data-kbd>⌘K</kbd>
      </button>
      <button class="q theme" type="button" data-theme-toggle aria-label="Switch between day and night">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <circle cx="8" cy="8" r="6.25" />
          <path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" />
        </svg>
      </button>
    </nav>
  </div>
</header>

{/* The index: the page as a ruler. Each tick sits where its section starts, and the mark is where you are. */}
<nav class="rail" data-index aria-label="Sections" data-night={cover ? "" : undefined} hidden={!home}>
  <span class="loupe" data-loupe aria-hidden="true" style={`clip-path:${loupe}`}><span></span></span>
  <span class="mark" data-mark aria-hidden="true"></span>
  {sections.map((s, i) => (
    <a href={at(s.id)} data-for={s.id} style={`--p:${i / (sections.length - 1)}`}>
      <span class="tick" aria-hidden="true"></span>
      <span class="lab"><span>{s.label}</span></span>
    </a>
  ))}
</nav>

<script>
  import { toggleTheme, getTheme } from "../scripts/theme";
  import { gsap } from "../scripts/motion";
  import { step, settled, mover, type Spring } from "../scripts/spring";
  // Inline links and drawn hairlines, on every page that has this bar.
  import "../scripts/hover";

  const bar = document.querySelector<HTMLElement>("[data-bar]")!;
  const cur = bar.querySelector<HTMLElement>("[data-crumb]")!;
  const next = bar.querySelector<HTMLElement>("[data-crumb-next]")!;
  const crumb = bar.querySelector<HTMLElement>(".crumb")!;
  const rail = document.querySelector<HTMLElement>("[data-index]")!;
  const mark = rail.querySelector<HTMLElement>("[data-mark]")!;
  const links = [...rail.querySelectorAll<HTMLAnchorElement>("a")];
  const cover = document.querySelector<HTMLElement>("[data-hero]");
  const fixedCrumb = !!cur.textContent;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Theme toggle. The label says what a press will do.
  const toggle = bar.querySelector<HTMLButtonElement>("[data-theme-toggle]")!;
  const label = () => toggle.setAttribute("aria-label", getTheme() === "dark" ? "Switch to the day theme" : "Switch to the night theme");
  toggle.addEventListener("click", () => {
    toggleTheme();
    label();
  });
  document.addEventListener("themechange", label);
  label();

  const kbd = bar.querySelector<HTMLElement>("[data-kbd]")!;
  if (!/Mac|iPhone|iPad/.test(navigator.platform)) kbd.textContent = "Ctrl K";

  // On a phone there is no room for the breadcrumb, so the jump button carries
  // the name of the section you are in, and opens the list of the others.
  const cmd = bar.querySelector<HTMLButtonElement>("[data-palette-open]")!;
  const jump = bar.querySelector<HTMLElement>("[data-jump]")!;
  const compact = window.matchMedia("(max-width: 640px) and (min-width: 360px)");
  function here(i: number) {
    // A page with a fixed breadcrumb (the paper) is always in that one place.
    const name = fixedCrumb ? cur.textContent!.trim() : i > 0 ? links[i].textContent!.trim() : "";
    const shown = name && compact.matches;
    jump.textContent = shown ? name : "Jump";
    jump.toggleAttribute("data-here", !!shown);
    cmd.setAttribute("aria-label", name ? `Open the command palette. You are in ${name}.` : "Open the command palette");
  }

  // The breadcrumb names the section under the middle of the screen. A new
  // name rolls up from below while the old one leaves through the top.
  let shown = "";
  let busy: Animation[] = [];
  function show(name: string) {
    if (fixedCrumb || name === shown) return;
    const first = !shown;
    const prev = shown;
    shown = name;
    crumb.toggleAttribute("data-on", !!name);
    // A second change can arrive while the first is still rolling. Settle it
    // first: the old name sits in place, and nothing of the old roll is left
    // to finish later and clear the new one.
    busy.forEach((a) => a.cancel());
    busy = [];
    next.textContent = "";
    if (first || reduce) {
      cur.textContent = name;
      return;
    }
    cur.textContent = prev;
    next.textContent = name;
    const opts = { duration: 320, easing: "cubic-bezier(0.65, 0, 0.35, 1)", fill: "forwards" as const };
    const roll = [
      cur.animate([{ transform: "translateY(0)", opacity: 1 }, { transform: "translateY(-100%)", opacity: 0 }], opts),
      next.animate([{ transform: "translateY(100%)", opacity: 0 }, { transform: "translateY(0)", opacity: 1 }], opts),
    ];
    busy = roll;
    roll[1].onfinish = () => {
      if (busy !== roll) return;
      cur.textContent = name;
      roll.forEach((a) => a.cancel());
      busy = [];
      next.textContent = "";
    };
  }

  // Where each section starts, as a fraction of the whole scroll. Heights move
  // as figures load and the cover pins, so this is measured again when they do.
  const targets = links.map((a) => document.getElementById(a.dataset.for!));
  let starts: number[] = [];
  let span = 1;
  let coverEnd = 0; // where the cover ends, in page coordinates, counting the stretch it is held for
  let coverHeld = 0; // how far down the page the cover is held still: past this it leaves, under the bar
  let footTop = Infinity; // where the night footer begins
  let railH = 0;
  let at: number[] = []; // where each tick sits down the rail, px
  let heads: (number | null)[] = []; // where each section's title is down the page, for those that have one
  let px = 1; // device pixels to a CSS pixel
  const foot = document.querySelector<HTMLElement>("[data-foot]");
  function measure() {
    span = Math.max(1, document.documentElement.scrollHeight - innerHeight);
    starts = targets.map((el) => (el ? Math.min(span, Math.max(0, el.getBoundingClientRect().top + scrollY - 80)) : 0));
    links.forEach((a, i) => a.style.setProperty("--p", (starts[i] / span).toFixed(4)));
    heads = targets.map((el) => {
      const h = el?.querySelector("h2");
      return h ? h.getBoundingClientRect().top + scrollY : null;
    });
    if (cover) {
      const hold = cover.closest<HTMLElement>("[data-hold]") ?? cover;
      const top = hold.getBoundingClientRect().top + scrollY;
      coverEnd = top + hold.offsetHeight;
      coverHeld = top + hold.offsetHeight - cover.offsetHeight;
    }
    if (foot) footTop = foot.getBoundingClientRect().top + scrollY;
    railH = rail.clientHeight;
    at = starts.map((s) => (s / span) * railH);
    px = devicePixelRatio || 1;
  }

  // ---------- the index: a mark with mass, a loupe that goes with it, labels that roll ----------
  //
  // The mark does not sit on the scroll, it follows it: a spring, critically
  // damped, so it leans behind a fast scroll and lands without passing its
  // place. Round it goes a loupe. While the mark is moving, the rail under it
  // shows its fine graduations, and any section's tick the loupe passes over
  // lengthens; the faster the mark, the wider the loupe opens, and it closes
  // when the mark comes to rest. At rest the rail is a line, seven ticks and a
  // dot. The loop below runs only while one of these is still moving, and
  // reads nothing from the page: everything it needs was measured above.

  const live = !reduce && !rail.hidden; // there is an index here, and it may move
  const wide = window.matchMedia("(min-width: 1340px)"); // and it is on show (the stylesheet draws the same line)
  const REACH = 60; // how far the loupe reaches either side of the mark, px (the frontmatter draws its outline to match)
  const SHORT = 9, LONG = 14; // a tick's length, px: at rest, and for the section you are in
  const loupe = rail.querySelector<HTMLElement>("[data-loupe]")!;
  const grads = loupe.firstElementChild as HTMLElement;
  const ticks = links.map((a) => a.querySelector<HTMLElement>(".tick")!);
  const labels = links.map((a) => a.querySelector<HTMLElement>(".lab > span")!);

  let aim = 0; // where the mark is wanted, px down the rail
  let placed = false;
  const pos: Spring = { x: 0, v: 0 }; // where it is
  const lens: Spring = { x: 0, v: 0 }; // how far the loupe is open, 0 to 1
  const lengths = links.map(() => SHORT); // each tick's length now, px
  const drawn = { mark: "", lens: "", ticks: links.map(() => "") }; // what was last written, so a steady frame writes nothing

  function draw() {
    const y = pos.x.toFixed(2);
    if (y !== drawn.mark) {
      mark.style.transform = `translateY(${(drawn.mark = y)}px)`;
      // The graduations belong to the rail, not to the loupe: they are moved back by exactly as much as it is moved on.
      grads.style.transform = `translateY(${-pos.x.toFixed(2)}px)`;
    }
    const open = `${y}|${lens.x.toFixed(3)}`;
    if (open !== drawn.lens) {
      drawn.lens = open;
      loupe.style.transform = `translateY(${y}px) scaleX(${lens.x.toFixed(3)})`;
    }
    for (let i = 0; i < ticks.length; i++) {
      const k = (lengths[i] / LONG).toFixed(3);
      if (k !== drawn.ticks[i]) ticks[i].style.transform = `scaleX(${(drawn.ticks[i] = k)})`;
    }
  }

  const wake = mover((dt) => {
    step(pos, aim, 10, dt);
    // Quick to open, slow to shut: it is the mark's speed made visible, and should outlast it a little.
    const want = Math.min(1, Math.max(0, (Math.abs(pos.v) - 3) / 24));
    step(lens, want, want > lens.x ? 12 : 4.5, dt);
    let moving = want > 0 || lens.x > 0.002 || !settled(pos, aim, 0.02);
    if (!moving) {
      pos.x = aim;
      pos.v = lens.x = lens.v = 0;
    }
    for (let i = 0; i < ticks.length; i++) {
      const far = Math.abs(at[i] - pos.x);
      const under = far < REACH ? Math.cos((Math.PI * far) / (2 * REACH)) ** 2 : 0;
      // (The current tick is already long; it is given less, so it stops short of its own label.)
      const to = i === active ? LONG + 3 * lens.x * under : SHORT + 5 * lens.x * under;
      lengths[i] += (to - lengths[i]) * (1 - Math.exp(-16 * dt));
      if (Math.abs(to - lengths[i]) > 0.02) moving = true;
      else lengths[i] = to;
    }
    draw();
    return moving;
  });

  // The label of the section you are in changes the way the breadcrumb does:
  // the old one leaves through the top of its slot, the new one comes up from
  // below. One caught part-way (a fast scroll past two sections) turns round
  // from where it is.
  const STATE = 320; // ms, the length of a change of state
  const swap = gsap.parseEase("swap");
  // (Where a rolling label is, in percent of its own height: 0 in its slot, 100 below it, -100 above. Kept here, so nothing has to be read back from the page.)
  const rolling = new WeakMap<HTMLElement, { run: Animation; from: number; to: number; began: number }>();
  function roll(el: HTMLElement, show: boolean) {
    const last = rolling.get(el);
    const t = last ? (performance.now() - last.began) / STATE : 1;
    const from = last && t < 1 ? last.from + (last.to - last.from) * swap(t) : show ? 100 : 0;
    const to = show ? 0 : from > 0 ? 100 : -100;
    last?.run.cancel();
    const run = el.animate([{ transform: `translateY(${from}%)` }, { transform: `translateY(${to}%)` }], { duration: STATE, easing: "cubic-bezier(0.65, 0, 0.35, 1)" });
    rolling.set(el, { run, from, to, began: performance.now() });
  }

  let active = -1;
  let queued = false;
  function update() {
    queued = false;
    const y = scrollY;
    bar.toggleAttribute("data-scrolled", y > 8);
    // Nothing here reads layout: on a scroll frame that would force the whole page to be laid out early.
    // Over either night scene (the cover, the footer) the bar takes night
    // colours. While the cover is held, and over the footer, it is clear glass
    // as well: the scene's own set pieces, the beam above all, run to the top
    // edge of the window. Once the cover starts to leave, its type goes up
    // under the bar, and the bar has its ground back just before it does.
    const onCover = cover ? coverEnd - y > 30 : false;
    const onFoot = footTop - y < 30;
    bar.toggleAttribute("data-night", onCover || onFoot);
    bar.toggleAttribute("data-over", (cover ? coverHeld - y > 24 : false) || onFoot);
    // The rail takes night colours over either night surface: the cover, and
    // the footer once it has reached the label of the section you are in.
    const overCover = cover ? coverEnd - y > innerHeight / 2 : false;
    const label = innerHeight / 2 - railH / 2 + (starts[Math.max(0, active)] / span) * railH;
    rail.toggleAttribute("data-night", overCover || footTop - y < label + 10);
    // The mark comes to rest on a whole device pixel, so it is as sharp standing still as the ticks are.
    aim = Math.round((y / span) * railH * px) / px;
    // The section you are in is the one whose title has reached the bar: the
    // title sinks behind its line there (scripts/reveal.ts) as the bar takes
    // up its name. A section with no title (the footer) counts from mid-screen.
    let i = 0;
    for (let k = 0; k < starts.length; k++) {
      const head = heads[k];
      if (targets[k] && (head != null ? y + 118 >= head : y + innerHeight * 0.45 >= starts[k] + 80)) i = k;
    }
    if (i !== active) {
      const was = active;
      active = i;
      links.forEach((a, k) => (k === i ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
      // With the whole index showing (the pointer or the keyboard is on it) no label comes or goes.
      if (live && wide.matches && was >= 0 && !rail.matches(":hover") && !rail.querySelector(":focus-visible")) {
        roll(labels[was], false);
        roll(labels[i], true);
      }
      show(i === 0 ? "" : links[i].textContent!.trim());
      here(i);
    }
    if (!live) {
      // Nothing is to move (or there is no index on this page): the mark is simply where it belongs, and the stylesheet sets the ticks.
      mark.style.transform = `translateY(${aim.toFixed(2)}px)`;
    } else if (!wide.matches) {
      // Out of sight on a narrower window: nothing runs for it, and it is put in place afresh when it comes back.
      placed = false;
    } else if (!placed) {
      // First of all everything is put where it belongs; from then on it is moved there.
      placed = true;
      pos.x = aim;
      pos.v = lens.x = lens.v = 0;
      lengths.forEach((_, k) => (lengths[k] = k === active ? LONG : SHORT));
      draw();
    } else wake();
  }
  const queue = () => {
    if (!queued) {
      queued = true;
      requestAnimationFrame(update);
    }
  };
  measure();
  update();
  compact.addEventListener("change", () => here(active));
  addEventListener("scroll", queue, { passive: true });
  addEventListener("resize", () => {
    measure();
    queue();
  });
  new ResizeObserver(() => {
    measure();
    queue();
  }).observe(document.body);
</script>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--bar);
    color: var(--ink);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    backdrop-filter: saturate(1.4) blur(12px);
    box-shadow: 0 1px 0 transparent;
    transition:
      box-shadow 0.3s ease,
      background-color 0.35s ease,
      color 0.35s ease;
  }
  /* On a cover page the bar lies over the cover rather than above it. */
  .bar.cover {
    margin-bottom: calc(-1 * var(--bar));
  }
  /* Over a night scene the bar is clear glass, so the scene runs to the top edge of the window. */
  .bar[data-over] {
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  /* There the links sit on moving light, so they take the stronger ink. */
  .bar[data-over] nav {
    color: var(--ink-2);
  }
  .bar[data-scrolled]:not([data-over]) {
    box-shadow: none;
  }
  /* By day the scene is still behind the page: the bar is paper all the way through, not a tint over the dark. */
  :global(html[data-voyage][data-theme="light"]) .bar:not([data-over]) {
    background: var(--paper);
  }
  /* The odometer: the camera's distance from the Sun, in the numerals every instrument here uses. */
  .odo {
    margin-right: auto;
    min-width: 7ch;
    font-size: 15px;
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .odo:empty {
    display: none;
  }
  @media (max-width: 900px) {
    .odo {
      display: none;
    }
  }
  .inner {
    height: var(--bar);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    font-size: 15px;
  }
  .name {
    display: inline-flex;
    align-items: baseline;
    min-height: 40px;
    padding-block: 9px;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .crumb {
    display: inline-flex;
    align-items: baseline;
    color: var(--ink-3);
    font-weight: 400;
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.3s ease,
      transform 0.4s var(--ease-out);
  }
  .crumb[data-on] {
    opacity: 1;
    transform: none;
  }
  .sep {
    margin: 0 0.5em;
    color: var(--ink-4);
  }
  .track {
    position: relative;
    display: inline-grid;
    overflow: hidden;
    height: 1.35em;
    line-height: 1.35;
  }
  .track > span {
    grid-area: 1 / 1;
  }
  nav[aria-label="Elsewhere"] {
    display: flex;
    align-items: center;
    gap: clamp(10px, 2vw, 26px);
    color: var(--ink-3);
  }
  .q {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    transition:
      color var(--t-press) var(--ease-io),
      transform var(--t-press) var(--ease-out);
  }
  /* A plain link's label rolls over into the stronger ink (.roll, in global.css). The rest take it where they stand. */
  :is(span, button).q:hover,
  :is(span, button).q:focus-within {
    color: var(--ink);
  }
  /* A press is felt: the two buttons give by a hair. */
  .cmd:active,
  .theme:active {
    transform: scale(0.97);
  }
  .q :global(.copy) {
    min-height: 40px;
    align-items: center;
  }
  .cmd {
    gap: 8px;
  }
  .cmd kbd {
    font-size: 12.5px;
    background: transparent;
    color: inherit;
  }
  .jump {
    display: none;
  }
  /* Showing a section's name, it gets a small chevron: it is where you are, and it opens the rest. */
  .jump[data-here]::after {
    content: "";
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-left: 7px;
    border: solid currentColor;
    border-width: 0 1px 1px 0;
    transform: translateY(-3px) rotate(45deg);
  }
  .theme {
    width: 40px;
    justify-content: center;
    margin-inline: -8px -12px;
  }
  .theme circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
  }
  .theme path {
    fill: currentColor;
    transform-origin: 8px 8px;
    transition: transform 0.6s var(--ease-out);
  }
  :global(:root[data-theme="dark"]) .theme path {
    transform: rotate(180deg);
  }
  @media (hover: none) {
    .cmd kbd { display: none; }
    .jump { display: inline; }
  }
  @media (max-width: 640px) {
    .hide-sm,
    .crumb {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .theme path, .q { transition: none; }
    .cmd:active, .theme:active { transform: none; }
  }

  /* ---------- index rail ---------- */
  .rail[hidden] {
    display: none;
  }
  .rail {
    --rail-h: min(46svh, 380px);
    position: fixed;
    z-index: 40;
    left: max(14px, calc((100vw - var(--measure) - 2 * var(--gutter)) / 2 + var(--gutter) - 86px));
    top: 50%;
    height: var(--rail-h);
    width: 14px;
    translate: 0 -50%;
    color: var(--ink);
    display: none;
  }
  .rail::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 1px;
    background: var(--hair);
  }
  .mark {
    position: absolute;
    left: -2px;
    top: -2.5px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }
  /* The loupe: a window, shaped like a swell, that rides on the mark (the
     script moves it and opens it). Behind it the rail's fine graduations stand
     still, one every 5px down its whole height; they are only ever seen
     through the window, and it is shut whenever the mark is at rest. */
  .loupe {
    position: absolute;
    left: 0;
    top: -60px;
    width: 6px;
    height: 120px;
    transform: scaleX(0);
    transform-origin: 0 50%;
    pointer-events: none;
  }
  .loupe > span {
    position: absolute;
    left: 0;
    top: 60px;
    width: 100%;
    height: var(--rail-h);
    background: repeating-linear-gradient(var(--ink-4) 0 1px, transparent 0 5px);
  }
  .rail a {
    position: absolute;
    left: 0;
    top: calc(var(--p) * 100%);
