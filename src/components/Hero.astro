---
import { fingerprint, hex } from "../scripts/worldline";

const SEED = "yuzeli";
const seedHex = hex(fingerprint(SEED));

// The cover's contents: the five facts a reader should leave with, each a way in.
const ledger = [
  { k: "Schulich Leader Scholarship", v: "$100K+", href: "#record" },
  { k: "NeurIPS 2026 workshops", v: "sole author", href: "#research" },
  { k: "TopsOJ, founder", v: "100,000+ users", href: "#work" },
  { k: "Waterloo Defence", v: "Software Lead", href: "#work" },
  { k: "Mathos AI (YC W24)", v: "engineering intern", href: "#work" },
];
---

<section class="hero" data-night data-hero data-seed={SEED} aria-labelledby="hero-h">
  <canvas class="sky" data-sky aria-hidden="true"></canvas>
  <noscript><img class="sky still" src="/cover.webp" alt="" /></noscript>
  {/* Names for a few bodies, pinned to them by the script. */}
  <div class="tags" aria-hidden="true">
    <span data-tag="swarm">Dyson swarm, 1 AU</span>
    <span data-tag="jupiter">Jupiter</span>
    <span data-tag="psyche">16 Psyche, quarry</span>
    <span data-tag="beam" class="hot">3.83 × 10²⁶ W, outbound</span>
  </div>

  <div class="frame wrap">
    <figure class="legend" aria-labelledby="hero-cap">
      <figcaption id="hero-cap">
        <span class="n num">Fig. 1</span>
        The Solar System with a Dyson swarm going up at 1 AU, simulated live from one seed like my{" "}
        <a class="ln" href="#projects">Worldline Engine</a>. Tugs fall in from the main belt on Hohmann
        transfers. Rolled to 8.5 g/m², the belt's 2.4 × 10²¹ kg is just enough foil to cover
        the whole sphere.
      </figcaption>
      <dl class="tele" data-tele>
        <div><dt>collectors</dt><dd class="cm"><span data-v="n">21,600</span> <i>/ <span data-v="total">60,000</span></i></dd></div>
        <div><dt>sunlight held</dt><dd class="cm"><span data-v="pct">36.0</span>% <i data-v="watts">1.38 × 10²⁶ W</i></dd></div>
        <div><dt>belt mined</dt><dd class="cm" data-v="mass">8.6 × 10²⁰ kg</dd></div>
        <div><dt>tugs in flight</dt><dd class="cm" data-v="tugs">150</dd></div>
        <div><dt>seed</dt><dd class="cm">{SEED} <i>→ {seedHex}</i></dd></div>
      </dl>
      <p class="fine">
        {/* The first line is only true while the scene is running; a still frame says so instead. */}
        <span class="hint" data-hint>Scroll to build it. Drag to look around.</span>
        <span class="held">Shown here as a still frame.</span>{" "}
        Orbits are Keplerian. Distances to scale; sizes and gaps are not.
      </p>
    </figure>

    <div class="id">
      <p class="cue"><span class="hint">Scroll to build it. Drag to look around.</span><span class="held">Fig. 1, shown here as a still frame.</span></p>
      <p class="eyebrow">Computer science, University of Waterloo</p>
      <h1 id="hero-h" aria-label="Jerry Li">
        {["Jerry", "Li"].map((word, w) => (
          <span class="word" aria-hidden="true">
            {[...word].map((ch, i) => <span class="ch" style={`--i:${w * 5 + i}`}>{ch}</span>)}
          </span>
        ))}
      </h1>
      <p class="lede">
        I build software people use in 182 countries, and I publish research: on when AI agents
        should hand work to other agents, and on how binary stars trade mass.
      </p>
    </div>

    <ol class="ledger" aria-label="At a glance">
      {ledger.map((row, i) => (
        <li style={`--i:${i}`}>
          <a href={row.href}>
            <span class="k">{row.k}</span>
            <span class="dots" aria-hidden="true"></span>
            <span class="v cm">{row.v}</span>
          </a>
        </li>
      ))}
    </ol>

    {/* Narrow screens have no index rail, so the sections are listed here as plain links. */}
    <nav class="jump" aria-label="Sections">
      <a href="#work">Work</a>
      <a href="#research">Research</a>
      <a href="#projects">Projects</a>
      <a href="#record">Record</a>
      <a href="#contact">Contact</a>
    </nav>
  </div>
</section>

<script>
  import "../scripts/hero";
</script>

<style>
  .hero {
    position: relative;
    background: #06080d;
    overflow: clip;
    isolation: isolate;
  }
  .sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    opacity: 0;
    transition: opacity 1.4s ease;
    cursor: grab;
    touch-action: pan-y;
  }
  .sky:active {
    cursor: grabbing;
  }
  .sky[data-on],
  .sky.still {
    opacity: 1;
  }
  .sky.still {
    object-fit: cover;
    cursor: auto;
  }

  /* Poster mode (?poster=0..1), used by tools/cover.mjs: only the scene. */
  :global(html[data-poster]) .frame,
  :global(html[data-poster]) .tags,
  :global(html[data-poster]) .hero::after {
    visibility: hidden;
  }

  /* Negative fill: the left of the frame is held down so the type reads, and the corners fall away. */
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(6 8 13 / 0.94), rgb(6 8 13 / 0.86) 26%, rgb(6 8 13 / 0.42) 46%, transparent 62%),
      linear-gradient(0deg, rgb(6 8 13 / 0.92), rgb(6 8 13 / 0.6) 14%, transparent 30%),
      linear-gradient(180deg, rgb(6 8 13 / 0.88), rgb(6 8 13 / 0.62) 7%, transparent 17%);
  }

  /* Small names riding on a few bodies. */
  .tags {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: clip;
  }
  .tags span {
    position: absolute;
    left: 0;
    top: 0;
    padding-left: 15px;
    font-size: 12.5px;
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--ink-3);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.5s ease;
    will-change: transform;
  }
  .tags span::before {
    content: "";
    position: absolute;
    left: 3px;
    top: 50%;
    width: 9px;
    height: 1px;
    background: var(--ink-4);
  }
  .tags span[data-on] {
    opacity: 1;
  }
  .tags .hot {
    color: var(--accent);
  }

  /* Legend top left, the stars filling the right, the name bottom left, the ledger along the foot. */
  .frame {
    pointer-events: none;
    min-height: max(100svh, 640px);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-rows: 1fr auto auto;
    grid-template-areas: "legend ." "id ." "ledger ledger";
    column-gap: clamp(32px, 6vw, 96px);
    padding-top: calc(var(--bar) + clamp(20px, 4.4svh, 44px));
    padding-bottom: clamp(24px, 4svh, 40px);
  }

  .legend,
  .id,
  .ledger {
    pointer-events: auto;
  }
  .legend {
    grid-area: legend;
    max-width: 318px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-3);
    animation: fade-up 0.9s var(--ease-out) 1.2s both;
  }
  .legend .n {
    color: var(--ink);
    margin-right: 0.5em;
  }
  .legend a {
    padding-block: 12px;
  }
  /* Telemetry: what the simulation is doing right now. */
  .tele {
    margin: 14px 0 0;
    border-top: 1px solid var(--hair);
  }
  .tele div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding-block: 5px;
    border-bottom: 1px solid var(--hair);
  }
  .tele dt {
    font-size: 12.5px;
  }
  .tele dd {
    font-size: 15px;
    line-height: 1.2;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .tele i {
    font-style: normal;
    color: var(--ink-3);
  }
  .fine {
    margin-top: 12px;
    font-size: 12.5px;
  }
  .hint {
    display: none;
    color: var(--ink-2);
  }
  .hero[data-live] .hint {
    display: inline;
  }
  .hero[data-live] .held {
    display: none;
  }

  .id {
    grid-area: id;
    align-self: end;
    padding-top: 28px;
  }
  .eyebrow {
    font-size: 15px;
    color: var(--ink-3);
    margin-bottom: clamp(6px, 1.4svh, 14px);
    animation: fade-up 0.9s var(--ease-out) 0.25s both;
  }
  h1 {
    font-size: clamp(72px, min(12.6vw, 21.5svh), 196px);
    line-height: 0.84;
    letter-spacing: -0.048em;
    font-weight: 500;
    display: flex;
    white-space: nowrap;
    column-gap: 0.2em;
    margin-left: -0.04em;
  }
  /* Page-load choreography is pure CSS, so it runs before any JS and costs nothing. */
  .word {
    display: inline-flex;
    overflow: clip;
    /* Room for descenders (the y) inside the reveal mask. */
    padding-bottom: 0.24em;
    margin-bottom: -0.24em;
  }
  .ch {
    display: inline-block;
    animation: rise 0.95s var(--ease-out) both;
    animation-delay: calc(0.15s + var(--i) * 30ms);
  }
  @keyframes rise {
    from { transform: translateY(105%); }
  }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(12px); }
  }
  .lede {
    margin-top: clamp(18px, 3svh, 30px);
    font-size: clamp(17.5px, 1.5vw, 21px);
    line-height: 1.45;
    color: var(--ink-2);
    max-width: 37ch;
    animation: fade-up 0.9s var(--ease-out) 0.55s both;
  }

  .jump,
  .cue {
    display: none;
  }

  /* The ledger: a plate of five facts along the foot of the cover. */
  .ledger {
    grid-area: ledger;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: clamp(22px, 4svh, 40px);
    border-top: 1px solid var(--hair);
  }
  .ledger li {
    animation: fade-up 0.8s var(--ease-out) both;
    animation-delay: calc(0.75s + var(--i) * 70ms);
  }
  .ledger li + li {
    border-left: 1px solid var(--hair);
  }
  .ledger a {
    display: flex;
    flex-direction: column-reverse;
    gap: 3px;
    height: 100%;
    padding: 14px 16px 2px;
    color: var(--ink-3);
    transition: color 0.2s ease;
  }
  .ledger li:first-child a {
    padding-left: 0;
  }
  .k {
    font-size: 13.5px;
    line-height: 1.35;
  }
  .dots {
    display: none;
  }
  .v {
    font-size: clamp(19px, 1.62vw, 23px);
    line-height: 1.15;
    color: var(--ink);
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  .ledger a:hover,
  .ledger a:focus-visible {
    color: var(--ink-2);
  }
  .ledger a:hover .v,
  .ledger a:focus-visible .v {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .ch, .lede, .eyebrow, .legend, .ledger li { animation: none; }
    .sky, .tags span { transition: none; }
  }

  /* Short windows: keep the name and the ledger, let the small print go. */
  @media (max-height: 800px) and (min-width: 881px) {
    .frame { padding-top: calc(var(--bar) + 14px); padding-bottom: 20px; }
    .fine { display: none; }
    .tele { margin-top: 10px; }
    .tele div { padding-block: 3px; }
    .id { padding-top: 16px; }
    h1 { font-size: clamp(72px, min(12.6vw, 18svh), 196px); }
    .lede { margin-top: 14px; font-size: 17px; }
    .ledger { margin-top: 18px; }
    .ledger a { padding-top: 10px; }
  }
  @media (max-height: 660px) and (min-width: 881px) {
    .tele { display: none; }
  }

  @media (max-width: 1100px) {
    .legend {
      max-width: 280px;
    }
    .k {
      font-size: 12.5px;
    }
  }

  /* Phones and small tablets: the stars on top, then everything in one column,
     and the ledger becomes a list with dotted leaders. */
  @media (max-width: 880px) {
    .frame {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding-top: calc(var(--bar) + var(--sky-h, 62vw) + 8px);
      padding-bottom: 40px;
    }
    .sky {
      height: calc(var(--bar) + var(--sky-h, 62vw) + 56px);
      -webkit-mask-image: linear-gradient(#000 78%, transparent);
      mask-image: linear-gradient(#000 78%, transparent);
    }
    .tags {
      height: calc(var(--bar) + var(--sky-h, 62vw) + 56px);
    }
    /* On a narrow screen the type sits under the scene, so only the top and the seam are held down. */
    .hero::after {
      background:
        linear-gradient(180deg, rgb(6 8 13 / 0.9), rgb(6 8 13 / 0.6) 5%, transparent 12%),
        linear-gradient(0deg, rgb(6 8 13 / 1) calc(100% - var(--bar) - var(--sky-h, 62vw) - 30px), transparent calc(100% - var(--bar) - var(--sky-h, 62vw) + 60px));
    }
    .cue {
      display: block;
      margin-bottom: 18px;
      font-size: 12.5px;
      color: var(--ink-3);
    }
    .hero .legend .hint,
    .hero .legend .held,
    .hero[data-live] .legend .hint {
      display: none;
    }
    .cue .hint {
      color: inherit;
    }
    .id { order: 1; }
    .ledger { order: 2; }
    .jump {
      order: 3;
      display: flex;
      flex-wrap: wrap;
      gap: 0 22px;
      margin-top: 10px;
      font-size: 15px;
      color: var(--ink-3);
      pointer-events: auto;
    }
    .jump a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
    .legend { order: 4; }
    h1 {
      font-size: clamp(64px, 21vw, 132px);
    }
    .lede {
      max-width: 40ch;
    }
    .ledger {
      display: block;
      margin-top: 32px;
      font-size: 15px;
    }
    .ledger li + li {
      border-left: 0;
    }
    .ledger li {
      border-bottom: 1px solid var(--hair);
    }
    .ledger a,
    .ledger li:first-child a {
      flex-direction: row;
      align-items: baseline;
      gap: 10px;
      padding: 12px 0;
      color: var(--ink-2);
    }
    .k {
      font-size: 15px;
      white-space: nowrap;
    }
    .dots {
      display: block;
      flex: 1;
      min-width: 16px;
      border-bottom: 1px dotted var(--ink-4);
      transform: translateY(-0.28em);
    }
    .v {
      font-size: 17px;
    }
    .legend {
      max-width: none;
      margin-top: 28px;
      animation-delay: 0.9s;
    }
  }
  @media (max-width: 420px) {
    .k {
      font-size: 13.5px;
    }
  }
</style>
