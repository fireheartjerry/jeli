---
import { fingerprint, hex } from "../scripts/worldline";

const SEED = "yuzeli";
const seedHex = hex(fingerprint(SEED));

// The cover's contents: the five facts a reader should leave with, each a way in.
const ledger = [
  { k: "Schulich Leader Scholarship", v: "$100K+", href: "#record" },
  { k: "NeurIPS 2026 workshops", v: "sole author", href: "#research" },
  { k: "TopsOJ, founder", v: "100,000+ users", href: "#work" },
  { k: "Waterloo Defence", v: "Software Lead", href: "#work" },
  { k: "Mathos AI (YC W24)", v: "engineering intern", href: "#work" },
];
---

{/*
  The cover is held at the top of the window while the swarm is built: it is
  sticky inside this taller box, and the stretch of scroll the box adds below
  it is the build (scripts/voyage.ts reads how far through it the page is).
  Nothing is moved in the document to hold it, so nothing on it starts over.
*/}
<div class="hold" data-hold>
<section class="hero" data-night data-hero data-seed={SEED} aria-labelledby="hero-h">
  {/* The scene itself is Cosmos.astro, fixed behind the page; this is what stands in without it. */}
  <noscript><img class="sky still" src="/cover.webp" alt="" /></noscript>

  <div class="frame wrap">
    <figure class="legend" aria-labelledby="hero-cap">
      <figcaption id="hero-cap">
        <span class="n num">Fig. 1</span>
        The Solar System with a Dyson swarm going up at 1 AU, simulated live from one seed like my{" "}
        <a class="ln" href="#projects">Worldline Engine</a>. Tugs fall in from the main belt on Hohmann
        transfers. Rolled to 8.5 g/m², the belt's 2.4 × 10²¹ kg is just enough foil to cover
        the whole sphere.
      </figcaption>
      <dl class="tele" data-tele>
        <div><dt>collectors</dt><dd class="cm"><span data-v="n">21,600</span> <i>/ <span data-v="total">60,000</span></i></dd></div>
        <div><dt>sunlight held</dt><dd class="cm"><span data-v="pct">36.0</span>% <i data-v="watts">1.38 × 10²⁶ W</i></dd></div>
        <div><dt>belt mined</dt><dd class="cm" data-v="mass">8.6 × 10²⁰ kg</dd></div>
        <div><dt>tugs in flight</dt><dd class="cm" data-v="tugs">150</dd></div>
        <div><dt>seed</dt><dd class="cm">{SEED} <i>→ {seedHex}</i></dd></div>
      </dl>
      <p class="fine">
        {/* The first line is only true while the scene is running; a still frame says so instead. */}
        <span class="hint" data-hint>Scroll to build it. Drag to look around.</span>
        <span class="held">Shown here as a still frame.</span>{" "}
        Orbits are Keplerian. Distances to scale; sizes, gaps and spin rates are not.
      </p>
    </figure>

    <div class="id">
      <p class="cue">
        <span class="hint">Scroll to build it. Drag to look around.</span><span class="held">Fig. 1, shown here as a still frame.</span>
        {/* The legend is below the fold on a narrow screen while the swarm is built, so its first line is said here too. */}
        <span class="live cm" aria-hidden="true"><span data-v="n">21,600</span> <i>/ <span data-v="total">60,000</span> collectors</i></span>
      </p>
      <p class="eyebrow">Computer science, University of Waterloo</p>
      <h1 id="hero-h" aria-label="Jerry Li">
        {["Jerry", "Li"].map((word, w) => (
          <span class="word" aria-hidden="true">
            {[...word].map((ch, i) => <span class="ch" style={`--i:${w * 5 + i}`}>{ch}</span>)}
          </span>
        ))}
      </h1>
      <p class="lede">
        I like AI agents, simulation and space. I build software, run experiments, and think about
        megastructures like the one on this page.
      </p>
    </div>

    <ol class="ledger" aria-label="At a glance">
      {ledger.map((row, i) => (
        <li style={`--i:${i}`}>
          {/* Under the pointer the value rolls over into the accent (.roll) and a hairline draws along the cell's top edge ([data-wire]); both are in global.css. */}
          <a href={row.href} data-wire>
            <span class="k">{row.k}</span>
            <span class="dots" aria-hidden="true"></span>
            <span class="v cm roll"><span>{row.v}</span></span>
          </a>
        </li>
      ))}
    </ol>

    {/* Narrow screens have no index rail, so the sections are listed here as plain links. */}
    <nav class="jump" aria-label="Sections">
      {["About", "Work", "Research", "Projects", "Record", "Contact"].map((name) => (
        <a href={`#${name.toLowerCase()}`}><span class="roll"><span>{name}</span></span></a>
      ))}
    </nav>
  </div>
</section>
</div>

<style>
  /* Only where there is a scene to build (the inline script in Base.astro says so before first paint; voyage.ts takes it back if the scene cannot run). */
  /* The stretch is a block of its own and not padding: a sticky box is kept inside its parent's content, and padding is outside it. */
  :global(html[data-motion]:not([data-flat])) .hold::after {
    content: "";
    display: block;
    height: 110svh;
  }
  .hero {
    position: sticky;
    top: 0;
    background: #06080d;
    overflow: clip;
    isolation: isolate;
  }
  /* With the scene running behind the page, the cover is a window onto it, and a drag on it swings the camera. */
  :global(html[data-voyage]) .hero {
    background: none;
    cursor: grab;
    touch-action: pan-y;
  }
  :global(html[data-voyage]) .hero:active {
    cursor: grabbing;
  }
  :global(html[data-voyage]) .hero::after {
    content: none;
  }
  .hero :global(.sky.still) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    object-fit: cover;
  }

  /* Poster mode (?poster=0..1), used by tools/cover.mjs: only the scene. */
  :global(html[data-poster]) .frame,
  :global(html[data-poster]) .hero::after {
    visibility: hidden;
  }

  /* Negative fill: the left of the frame is held down so the type reads, and the corners fall away. */
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(6 8 13 / 0.94), rgb(6 8 13 / 0.86) 26%, rgb(6 8 13 / 0.42) 46%, transparent 62%),
      linear-gradient(0deg, rgb(6 8 13 / 0.92), rgb(6 8 13 / 0.6) 14%, transparent 30%),
      linear-gradient(180deg, rgb(6 8 13 / 0.88), rgb(6 8 13 / 0.62) 7%, transparent 17%);
  }

  /* Legend top left, the stars filling the right, the name bottom left, the ledger along the foot. */
  .frame {
    pointer-events: none;
    min-height: max(100svh, 640px);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-rows: 1fr auto auto;
    grid-template-areas: "legend ." "id ." "ledger ledger";
    column-gap: clamp(32px, 6vw, 96px);
    padding-top: calc(var(--bar) + clamp(20px, 4.4svh, 44px));
    padding-bottom: clamp(24px, 4svh, 40px);
  }

  .legend,
  .id,
  .ledger {
    pointer-events: auto;
  }
  .legend {
    grid-area: legend;
    max-width: 318px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-3);
  }
  /* The legend comes in last, a part at a time: its caption, each line of telemetry, the small print. */
  .legend > figcaption,
  .tele > div,
  .legend > .fine {
    animation: rise-in var(--t-arrive) var(--ease-out) backwards;
    animation-delay: calc(1.15s + var(--j, 0) * 60ms);
  }
  .tele > div:nth-child(1) { --j: 2; }
  .tele > div:nth-child(2) { --j: 3; }
  .tele > div:nth-child(3) { --j: 4; }
  .tele > div:nth-child(4) { --j: 5; }
  .tele > div:nth-child(5) { --j: 6; }
  .legend > .fine { --j: 8; }
  .legend .n {
    color: var(--ink);
    margin-right: 0.5em;
  }
  .legend a {
    padding-block: 12px;
  }
  /* Telemetry: what the simulation is doing right now. */
  .tele {
    margin: 14px 0 0;
    border-top: 1px solid var(--hair);
  }
  .tele div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding-block: 5px;
    border-bottom: 1px solid var(--hair);
  }
  .tele dt {
    font-size: 12.5px;
  }
  .tele dd {
    font-size: 15px;
    line-height: 1.2;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .tele i {
    font-style: normal;
    color: var(--ink-3);
  }
  .fine {
    margin-top: 12px;
    font-size: 12.5px;
  }
  .hint {
    display: none;
    color: var(--ink-2);
  }
  /* Where the scene will run (Base.astro says so before first paint) the line says how to use it; anywhere else, that it is a still. */
  :global(html[data-motion]:not([data-flat])) .hint {
    display: inline;
  }
  :global(html[data-motion]:not([data-flat])) .held {
    display: none;
  }

  .id {
    grid-area: id;
    align-self: end;
    padding-top: 28px;
  }
  .eyebrow {
    font-size: 15px;
    color: var(--ink-3);
    margin-bottom: clamp(6px, 1.4svh, 14px);
    animation: rise-in var(--t-arrive) var(--ease-out) 0.25s backwards;
  }
  h1 {
    font-size: clamp(72px, min(12.6vw, 21.5svh), 196px);
    line-height: 0.84;
    letter-spacing: -0.048em;
    font-weight: 500;
    display: flex;
    white-space: nowrap;
    column-gap: 0.2em;
    margin-left: -0.04em;
  }
  /*
    The opening is pure CSS: it costs nothing, and it is the page's own
    vocabulary. The name rises by the letter inside its word; every other
    block rises from behind its own foot (it is moved down by its height and
    cut off at its foot by as much, so the edge it comes up through stays put);
    the ledger's rule is drawn from the left and its dividers grow down from it.
    It waits for the scene, so that type and scene arrive together, but never
    for more than a third of a second (Base.astro's inline script lets it go).
  */
  .word {
    display: inline-flex;
    overflow: clip;
    /* Room for descenders (the y) inside the reveal mask. */
    padding-bottom: 0.24em;
    margin-bottom: -0.24em;
  }
  .ch {
    display: inline-block;
    animation: rise var(--t-arrive) var(--ease-out) both;
    animation-delay: calc(0.15s + var(--i) * 30ms);
  }
  /* (Far enough down that no tall letter's tip shows in the room left for descenders.) */
  @keyframes rise {
    from { transform: translateY(130%); }
  }
  @keyframes rise-in {
    from { transform: translateY(104%); clip-path: inset(0 0 104% 0); }
    to { transform: none; clip-path: inset(0 0 -30% 0); }
  }
  @keyframes slot-in {
    from { transform: translateY(125%); }
  }
  @keyframes draw-x {
    from { transform: scaleX(0); }
  }
  @keyframes draw-y {
    from { transform: scaleY(0); }
  }
  :global(html[data-motion]:not([data-voyage]):not([data-go])) .hero *,
  :global(html[data-motion]:not([data-voyage]):not([data-go])) .hero *::before {
    animation-play-state: paused;
  }
  .lede {
    margin-top: clamp(18px, 3svh, 30px);
    font-size: clamp(17.5px, 1.5vw, 21px);
    line-height: 1.45;
    color: var(--ink-2);
    max-width: 37ch;
    animation: rise-in var(--t-arrive) var(--ease-out) 0.5s backwards;
  }

  .jump,
  .cue {
    display: none;
  }

  /* The ledger: a plate of five facts along the foot of the cover. */
  .ledger {
    grid-area: ledger;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: clamp(22px, 4svh, 40px);
    position: relative;
    border-top: 1px solid transparent;
  }
  /* Its rule is drawn from the left; each divider grows down from the rule as the rule reaches it. */
  .ledger::before {
    content: "";
    position: absolute;
    inset: -1px 0 auto;
    height: 1px;
    background: var(--hair);
    transform-origin: left;
    animation: draw-x var(--t-arrive) var(--ease-out) 0.7s backwards;
  }
  .ledger li {
    position: relative;
  }
  .ledger li + li::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 1px;
    background: var(--hair);
    transform-origin: top;
    animation: draw-y var(--t-state) var(--ease-io) backwards;
    animation-delay: calc(0.82s + var(--i) * 70ms);
  }
  /* And in each cell the value comes up into its slot, its label from behind its own foot. */
  .ledger .v > span {
    animation: slot-in var(--t-arrive) var(--ease-out) backwards;
    animation-delay: calc(0.9s + var(--i) * 70ms);
  }
  .ledger .k {
    animation: rise-in var(--t-arrive) var(--ease-out) backwards;
    animation-delay: calc(0.96s + var(--i) * 70ms);
  }
  .ledger a {
    display: flex;
    flex-direction: column-reverse;
    gap: 3px;
    height: 100%;
    padding: 14px 16px 2px;
    color: var(--ink-3);
    transition:
      color var(--t-press) var(--ease-io),
      --u var(--t-press) var(--ease-io);
  }
  .ledger li:first-child a {
    padding-left: 0;
  }
  /* The cell's hairline lies on the ledger's own rule, and over the first pixel of the divider beside it. */
  .ledger a::before {
    inset: -1px 0 auto;
  }
  .ledger li + li a::before {
    left: -1px;
  }
  .k {
    font-size: 13.5px;
    line-height: 1.35;
  }
  .dots {
    display: none;
  }
  /* Computer Modern is set tighter than its own ink, so the slot the value rolls in is given a little room. */
  .v {
    --roll-ink: var(--accent);
    --roll-room: 2px;
    font-size: clamp(19px, 1.62vw, 23px);
    line-height: 1.15;
    color: var(--ink);
    white-space: nowrap;
  }
  .ledger a:hover,
  .ledger a:focus-visible {
    color: var(--ink-2);
  }
  @media (prefers-reduced-motion: reduce) {
    .ledger a {
      transition: none;
    }
  }

  /* With reduced motion the cover is simply there: nothing on it arrives. */
  @media (prefers-reduced-motion: reduce) {
    .hero *,
    .hero *::before,
    .hero *::after {
      animation: none !important;
    }
  }

  /* Short windows: keep the name and the ledger, let the small print go. */
  @media (max-height: 800px) and (min-width: 881px) {
    .frame { padding-top: calc(var(--bar) + 14px); padding-bottom: 20px; }
    .fine { display: none; }
    .tele { margin-top: 10px; }
    .tele div { padding-block: 3px; }
    .id { padding-top: 16px; }
    h1 { font-size: clamp(72px, min(12.6vw, 18svh), 196px); }
    .lede { margin-top: 14px; font-size: 17px; }
    .ledger { margin-top: 18px; }
    .ledger a { padding-top: 10px; }
  }
  @media (max-height: 660px) and (min-width: 881px) {
    .tele { display: none; }
  }

  @media (max-width: 1100px) {
    .legend {
      max-width: 280px;
    }
    .k {
      font-size: 12.5px;
    }
  }

  /* Phones and small tablets: the stars on top, then everything in one column,
     and the ledger becomes a list with dotted leaders. */
  @media (max-width: 880px) {
    .frame {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding-top: calc(var(--bar) + var(--sky-h, 62vw) + 8px);
      padding-bottom: 40px;
    }
    .hero :global(.sky.still) {
      height: calc(var(--bar) + var(--sky-h, 62vw) + 56px);
      -webkit-mask-image: linear-gradient(#000 78%, transparent);
      mask-image: linear-gradient(#000 78%, transparent);
    }
    /* On a narrow screen the type sits under the scene, so only the top and the seam are held down. */
    .hero::after {
      background:
        linear-gradient(180deg, rgb(6 8 13 / 0.9), rgb(6 8 13 / 0.6) 5%, transparent 12%),
        linear-gradient(0deg, rgb(6 8 13 / 1) calc(100% - var(--bar) - var(--sky-h, 62vw) - 30px), transparent calc(100% - var(--bar) - var(--sky-h, 62vw) + 60px));
    }
    /* With the scene running behind the page, the cover keeps its own ground
       under its type and carries it off when it leaves, so the name is never
       read against the sphere. It thins out at the foot, into the open sky. */
    :global(html[data-voyage]) .hero::after {
      content: "";
      background: linear-gradient(180deg, transparent calc(var(--bar) + var(--sky-h, 62vw) - 64px), #06080d calc(var(--bar) + var(--sky-h, 62vw) + 30px), #06080d calc(100% - 150px), transparent);
    }
    :global(html[data-motion]:not([data-flat])) .hold::after {
      height: 150svh;
    }
    .cue {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 12px;
      margin-bottom: 18px;
      font-size: 12.5px;
      color: var(--ink-3);
      animation: rise-in var(--t-arrive) var(--ease-out) 0.2s backwards;
    }
    .cue .live {
      font-size: 14px;
      color: var(--ink);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    .cue .live i {
      font-style: normal;
      color: var(--ink-3);
    }
    /* The count is as wide as it will ever be from the start, so the line beside it never re-wraps as the digits come. */
    .cue .live [data-v="n"] {
      display: inline-block;
      min-width: 6ch;
      text-align: right;
    }
    /* Its room is kept from the first paint, so nothing below moves when the scene starts and the count appears. */
    .hero:not([data-live]) .cue .live {
      visibility: hidden;
    }
    :global(html:not([data-motion])) .cue .live,
    :global(html[data-flat]) .cue .live {
      display: none;
    }
    /* The ledger is a list here: a rule over it and under each line, none to draw across or down. */
    .ledger {
      border-top-color: var(--hair);
    }
    .ledger::before,
    .ledger li + li::before {
      content: none;
    }
    .hero .legend .hint,
    .hero .legend .held,
    :global(html[data-motion]:not([data-flat])) .hero .legend .hint {
      display: none;
    }
    .cue .hint {
      color: inherit;
    }
    .id { order: 1; }
    .ledger { order: 2; }
    .jump {
      order: 3;
      display: flex;
      flex-wrap: wrap;
      gap: 0 22px;
      margin-top: 10px;
      font-size: 15px;
      color: var(--ink-3);
      pointer-events: auto;
    }
    .jump a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
    .legend { order: 4; }
    h1 {
      font-size: clamp(64px, 21vw, 132px);
    }
    .lede {
      max-width: 40ch;
    }
    .ledger {
      display: block;
      margin-top: 32px;
      font-size: 15px;
    }
    .ledger li + li {
      border-left: 0;
    }
    .ledger li + li a::before {
      left: 0;
    }
    .ledger li {
      border-bottom: 1px solid var(--hair);
    }
    .ledger a,
    .ledger li:first-child a {
      flex-direction: row;
      align-items: baseline;
      gap: 10px;
      padding: 12px 0;
      color: var(--ink-2);
    }
    .k {
      font-size: 15px;
      white-space: nowrap;
    }
    .dots {
      display: block;
      flex: 1;
      min-width: 16px;
      border-bottom: 1px dotted var(--ink-4);
      transform: translateY(-0.28em);
    }
    .v {
      font-size: 17px;
    }
    .legend {
      max-width: none;
      margin-top: 28px;
    }
  }
  @media (max-width: 420px) {
    .k {
      font-size: 13.5px;
    }
  }
</style>
