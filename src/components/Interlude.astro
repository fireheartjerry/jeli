---
/**
 * A stretch of open sky between two parts of the page. The scene behind the
 * page (Cosmos.astro) frames one thing out past the Solar System here, with
 * nothing over it but a line of caption: a black hole, a supernova, a quasar.
 * scripts/voyage.ts tells the camera where each one is, so that it is centred
 * when its stretch of page is.
 *
 * It is only there where the scene runs (html[data-motion], the same test the
 * cover's hold makes before first paint). Without it, or with reduced motion,
 * there is nothing to look at, and the page closes up over it.
 */
interface Props {
  kind: "hole" | "nova" | "quasar" | "wormhole";
  /** What is being shown, said plainly. */
  name: string;
  caption: string;
}
const { kind, name, caption } = Astro.props;
---

<div class="interlude" data-interlude={kind} aria-label={name} role="img">
  <div class="cap wrap">
    <p class="k" data-reveal="lines">{name}</p>
    <p class="say" data-reveal="lines">{caption}</p>
  </div>
</div>

<style>
  .interlude {
    display: none;
    position: relative;
    pointer-events: none;
  }
  :global(html[data-motion]:not([data-flat])) .interlude {
    display: block;
    height: 118svh;
  }
  .cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 18svh;
  }
  .k {
    font-size: 12.5px;
    letter-spacing: 0.01em;
    color: var(--ink-3);
    margin-bottom: 8px;
  }
  .say {
    max-width: 44ch;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
    text-shadow: 0 0 18px rgb(6 8 13 / 0.9), 0 0 4px rgb(6 8 13 / 0.8);
  }
  /* By day too the stretch is open sky: it is the scene's own night, so its type is night type. */
  .interlude {
    --ink-2: #c9c7bf;
    --ink-3: #8f8e88;
  }
  @media (max-width: 880px) {
    :global(html[data-motion]:not([data-flat])) .interlude {
      height: 96svh;
    }
    .cap {
      bottom: 10svh;
    }
    .say {
      font-size: 14px;
    }
  }
</style>
