---
interface Props {
  id: string;
  title: string;
  lede?: string;
}
const { id, title, lede } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-h`} class="wrap" data-section={title} data-ground>
  <header class="sec-h" data-reveal="title">
    <h2 id={`${id}-h`}>{title}</h2>
    {lede && <p>{lede}</p>}
  </header>
  <slot />
</section>

<style>
  section {
    padding-top: clamp(72px, 9vw, 136px);
  }
  .sec-h {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: clamp(32px, 6vw, 96px);
    align-items: baseline;
    padding-bottom: clamp(20px, 3vw, 36px);
  }
  h2 {
    font-size: clamp(40px, 5vw, 68px);
    line-height: 1;
    letter-spacing: -0.038em;
  }
  .sec-h p {
    font-size: 17px;
    color: var(--ink-3);
    max-width: 46ch;
  }
  @media (max-width: 880px) {
    .sec-h {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 12px;
    }
  }
</style>
