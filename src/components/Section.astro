---
interface Props {
  id: string;
  title: string;
  lede?: string;
}
const { id, title, lede } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-h`} class="wrap" data-section={title} data-ground>
  <header class="sec-h" data-reveal="title">
    <h2 id={`${id}-h`}>{title}</h2>
    {lede && <p>{lede}</p>}
  </header>
  <slot />
</section>

<style>
  /* The page keeps to the left; the right of the window is left to the sky. */
  section {
    padding-top: clamp(72px, 9vw, 136px);
  }
  section > :global(*) {
    max-width: 560px;
  }
  .sec-h {
    display: grid;
    row-gap: 14px;
    padding-bottom: clamp(12px, 2vw, 24px);
  }
  h2 {
    font-size: clamp(40px, 5vw, 68px);
    line-height: 1;
    letter-spacing: -0.038em;
  }
  .sec-h p {
    font-size: 17px;
    color: var(--ink-3);
    max-width: 46ch;
  }
</style>
