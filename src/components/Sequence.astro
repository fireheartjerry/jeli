---
/**
 * A sequence: a stretch of page held still while a scene plays through, a step
 * at a time, as the page is scrolled (scripts/sequence.ts). The scene is drawn
 * by the renderer named in `scene`; the words are here, one step showing at a
 * time, all of them read out in order to a screen reader.
 *
 * Like the interludes, it is only there where scenes run (html[data-motion]);
 * without that it closes up, and the page reads on without it.
 */
interface Step {
  /** Where in the sequence this step starts, 0 to 1. */
  at: number;
  /** When, in the story: a time, plainly. */
  when: string;
  title: string;
  text: string;
  /** How much is in the frame. */
  scale: string;
}
interface Props {
  scene: "supernova" | "deeptime";
  name: string;
  steps: Step[];
  /** How many screens of scrolling it takes. */
  length?: number;
}
const { scene, name, steps, length = 9 } = Astro.props;
---

<section class="seq" data-seq={scene} aria-label={name} style={`--len: ${length}`}>
  <div class="stage">
    <canvas class="seq-canvas" data-seq-canvas aria-hidden="true"></canvas>
    <div class="hud wrap">
      <p class="name">{name}</p>
      <ol class="steps">
        {steps.map((s, i) => (
          <li data-step={i} data-at={s.at} data-scale={s.scale}>
            <p class="when cm">{s.when}</p>
            <h3>{s.title}</h3>
            <p class="text">{s.text}</p>
          </li>
        ))}
      </ol>
      <div class="foot" aria-hidden="true">
        <span class="scale" data-seq-scale>{steps[0]?.scale}</span>
        <span class="ticks">
          {steps.map((s) => <i style={`left: ${s.at * 100}%`}></i>)}
          <b data-seq-bar></b>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .seq {
    display: none;
  }
  :global(html[data-motion]:not([data-flat])) .seq {
    display: block;
    height: calc(var(--len) * 100svh);
  }
  :global(html[data-motion]:not([data-flat])) .seq[data-off] {
    display: none;
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: clip;
    background: #000;
    --ink: #eeece6;
    --ink-2: #c9c7bf;
    --ink-3: #8f8e88;
    --hair: rgb(255 255 255 / 0.12);
    color: var(--ink);
  }
  .seq-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .hud {
    position: relative;
    height: 100%;
    pointer-events: none;
  }
  .name {
    position: absolute;
    top: calc(var(--bar) + 24px);
    font-size: 12.5px;
    letter-spacing: 0.01em;
    color: var(--ink-3);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* One step at a time, low on the left, over the dark side of the frame. */
  .steps li {
    position: absolute;
    bottom: 92px;
    max-width: 40ch;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity var(--t-state) var(--ease-io),
      transform var(--t-arrive) var(--ease-out);
    text-shadow: 0 0 20px rgb(0 0 0 / 0.9), 0 0 4px rgb(0 0 0 / 0.8);
  }
  .steps li[data-on] {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--t-arrive) var(--ease-out) 0.08s,
      transform var(--t-arrive) var(--ease-out) 0.08s;
  }
  .when {
    font-size: 14px;
    color: var(--accent);
    margin-bottom: 8px;
  }
  h3 {
    font-size: clamp(26px, 2.6vw, 38px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-weight: 500;
    margin-bottom: 12px;
  }
  .text {
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  /* How far through: a hairline with a tick for each step, and how much is in the frame. */
  .foot {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 36px;
    display: flex;
    align-items: center;
    gap: 20px;
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .scale {
    min-width: 22ch;
    white-space: nowrap;
  }
  .ticks {
    position: relative;
    flex: 1;
    height: 1px;
    background: var(--hair);
  }
  .ticks i {
    position: absolute;
    top: -3px;
    width: 1px;
    height: 7px;
    background: var(--ink-3);
  }
  .ticks b {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(var(--p, 0));
  }
  @media (max-width: 880px) {
    .steps li {
      bottom: 84px;
      right: var(--gutter);
    }
    h3 {
      font-size: 26px;
    }
    .text {
      font-size: 15px;
    }
    .scale {
      min-width: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .steps li,
    .steps li[data-on] {
      transition: none;
    }
  }
</style>

<script>
  import "../scripts/sequence";
</script>
