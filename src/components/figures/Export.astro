  .fig svg.ex .needle { fill: none; stroke: var(--ink); stroke-width: 1.1; }

  /* A state is told in colour as well as in words, and a change of state is never a flash. */
  .fig svg.ex .btn, .fig svg.ex .abtn { transition: fill 0.18s var(--ease-out), stroke 0.18s var(--ease-out); }
  .fig svg.ex .pill { transition: stroke 0.32s var(--ease-out), stroke-width 0.32s var(--ease-out); }
  .fig svg.ex .row .gl, .fig svg.ex .row text { transition: stroke 0.32s var(--ease-out), fill 0.32s var(--ease-out); }

  /* Pointer, touch and keyboard: a stage steps forward and the rest step back. */
  .fig svg.ex .hit { fill: transparent; stroke: none; pointer-events: all; }
  /* A finger may go across the drawing (along the big sandbox it steps through frames); up and down it scrolls the page as ever.
     Set on the drawing itself: a browser does not take this from a shape inside an svg. */
  .fig svg.ex[data-live] { touch-action: pan-y pinch-zoom; }
  .fig svg.ex[data-live] .hit { cursor: default; }
  .fig svg.ex .hit:focus { outline: none; }
  .fig svg.ex .ring { fill: none; stroke: none; pointer-events: none; }
  .fig svg.ex .hit:focus-visible + .ring { stroke: var(--accent); stroke-width: 1.5px; vector-effect: non-scaling-stroke; }
  .fig svg.ex .st { transition: opacity 0.32s var(--ease-out); }
  .fig svg.ex.focus .st:not(.on) { opacity: 0.42; }
