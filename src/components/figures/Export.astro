  .fig svg.ex .tile.our text { fill: var(--accent); }
  .fig svg.ex .env { fill: var(--panel); stroke: var(--ink); stroke-width: 1.1; stroke-linejoin: round; }

  /* A sandbox's outline while it is being drawn: a short bright stroke at the head of the line. */
  .fig svg.ex .pen { fill: none; stroke: var(--ink); stroke-width: 2.2; stroke-linecap: round; stroke-dasharray: 0.024 1; }
