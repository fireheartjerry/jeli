  .fig svg.ex .strip0 { stroke: rgb(var(--ink-rgb) / 0.1); stroke-width: 9; }
  .fig svg.ex .strip1 { stroke: var(--ink-3); stroke-width: 9; }

  /* The lesson frame. */
  .fig svg.ex .ax { fill: none; stroke: var(--ink-4); stroke-width: 0.8; }
  .fig svg.ex .curve { fill: none; stroke: var(--ink); stroke-width: 1.25; stroke-linejoin: round; }
  .fig svg.ex .tri { stroke: var(--ink-3); stroke-width: 0.9; stroke-dasharray: 1.5 2; }
  .fig svg.ex .tan { stroke: var(--ink-2); stroke-width: 1.5; stroke-linecap: round; }
  .fig svg.ex .pt { fill: var(--ink); stroke: var(--panel); stroke-width: 1.2; }
  .fig svg.ex .bx.our .tan { stroke: var(--accent); stroke-width: 1.7; }
  .fig svg.ex .bx.our .pt { fill: var(--accent); }

  /* The timeline. */
  .fig svg.ex .sc { fill: rgb(var(--ink-rgb) / 0.1); stroke: none; }
  .fig svg.ex .sc.on { fill: var(--ink-3); }
  .fig svg.ex .na { fill: none; stroke: rgb(var(--ink-rgb) / 0.2); stroke-width: 1.4; stroke-linecap: round; }
  .fig svg.ex .na.on { stroke: var(--ink-2); }
  .fig svg.ex .ph { fill: var(--ink); stroke: var(--ink); stroke-width: 1; stroke-linejoin: round; }
