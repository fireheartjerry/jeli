  .fig svg.ex .row.our text.id, .fig svg.ex .row.our text.src, .fig svg.ex .row.our text.state { fill: var(--accent); }

  /* Sandboxes. */
  .fig svg.ex .gh { fill: none; stroke: var(--ink-4); stroke-width: 1; stroke-dasharray: 2 4; }
  .fig svg.ex .bx .bg { fill: var(--panel-2); stroke: none; }
  .fig svg.ex .bx .o { fill: none; stroke: var(--ink); stroke-width: 1.25; }
  .fig svg.ex .bx.our .o { stroke: var(--accent); stroke-width: 1.5; }
  .fig svg.ex .bx.our .id { fill: var(--accent); }
