  .fig svg.ex .film { fill: rgb(var(--ink-rgb) / 0.09); }
  .fig svg.ex .sprk { fill: none; stroke: var(--panel-2); stroke-width: 2.4; }
  .fig svg.ex .cell0 { fill: var(--panel-2); stroke: none; }
  .fig svg.ex .cell1 { fill: var(--panel); stroke: var(--ink-4); stroke-width: 0.8; }
