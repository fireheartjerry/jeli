  .fig svg.ex .tg { fill: none; stroke: var(--ink); stroke-width: 1.1; stroke-linecap: round; }
  .fig svg.ex .cur { fill: none; stroke: var(--ink); stroke-width: 1.2; }
  .fig svg.ex .scan { fill: none; stroke: var(--ink-3); stroke-width: 1; }
  .fig svg.ex .bx.our .tg, .fig svg.ex .bx.our .cur, .fig svg.ex .bx.our .scan { stroke: var(--accent); }

