  .fig svg.ex .pill { fill: var(--panel); stroke: var(--ink-3); stroke-width: 1; }
  .fig svg.ex .pill.any { fill: none; stroke: var(--ink-4); stroke-dasharray: 2 3; }
  .fig svg.ex .pill.hot { stroke: var(--ink); stroke-width: 1.5; }
  .fig svg.ex .pill.any.hot { stroke: var(--ink-2); stroke-width: 1.2; }
