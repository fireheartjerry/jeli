---
// Fig: the fire-control problem behind Waterloo Defence's counter-drone mount.
// A side view to scale: the camera tracks a drone, the solver finds the one
// elevation that puts a round and the drone at the same point at the same
// time, and the mount slews to it. The physics (RK4 with quadratic drag, a
// fixed-point solve for the lead) lives in src/scripts/geo/intercept.ts and
// is shared with the script, so the server renders the solved engagement and
// the client re-solves it wherever the reader drags the drone.
//
// The plot is rendered in two layouts (wide, and a taller one for narrow
// screens); CSS shows one. Every number is an illustrative textbook value.
import Figure from "../Figure.astro";
import {
  GUN, TARGET, CAMERA, D0, BOUNDS, TICK, MAX_ITER, LAYOUTS,
  createSolution, solve, detections, fitTrack, geom, artScale, fx, plotY, readoutFlight,
  type Layout,
} from "../../scripts/geo/intercept";

interface Props { n?: number }
const { n = 3 } = Astro.props;

// The default engagement: track the drone, fit its velocity, solve.
const det = detections(D0.x, D0.y, -TARGET.speed, 0, new Float64Array(TARGET.frames * 2));
const est = fitTrack(det, new Float64Array(4));
const S = solve(est[0], est[1], est[2], est[3], createSolution());
if (!S.ok || S.miss > 0.01) throw new Error(`intercept: default engagement did not converge (miss ${S.miss} m)`);

const RAD = Math.PI / 180;
const r1 = (v: number) => Math.round(v * 10) / 10;

/** Everything in a layout that does not move: grid, axes, the camera's field of view, frames. */
function backdrop(L: Layout) {
  const { ox, oy, s, top, right } = L;
  // Range rings every 20 m, centred on the mount.
  let rings = "";
  const ringR = [20, 40, 60, 80];
  for (const R of ringR) {
    const r = R * s;
    const a0 = ox + r <= right ? 0 : Math.acos((right - ox) / r);
    const a1 = Math.min(48 * RAD, Math.asin(Math.min(1, (oy - top) / r)));
    if (a1 <= a0) continue;
    rings += `M${r1(ox + r * Math.cos(a0))} ${r1(oy - r * Math.sin(a0))}A${r1(r)} ${r1(r)} 0 0 0 ${r1(ox + r * Math.cos(a1))} ${r1(oy - r * Math.sin(a1))}`;
  }
  let ticks = "";
  const labels: { x: number; t: string }[] = [];
  for (let R = 10; ox + R * s <= right - 2; R += 10) {
    ticks += `M${r1(ox + R * s)} ${oy}v${R % 20 ? 3.5 : 6}`;
    if (R % 20 === 0) labels.push({ x: r1(ox + R * s), t: `${R}` });
  }
  // The fixed camera sits on a post behind the rifle; its field of view is a wedge
  // from the lens (the front of the camera body drawn below, after its tilt).
  // The wedge runs past the viewBox so it reaches the screen's edge (the plot clips it).
  const lens = { x: ox + 7.4 * L.art, y: oy - 52.3 * L.art };
  const over = 60;
  const ray = (deg: number) => {
    const c = Math.cos(deg * RAD), sn = Math.sin(deg * RAD);
    const t = Math.min((right + over - lens.x) / c, (lens.y - top + over) / sn);
    return { x: r1(lens.x + t * c), y: r1(lens.y - t * sn), t };
  };
  const lo = ray(CAMERA.tilt - CAMERA.half), hi = ray(CAMERA.tilt + CAMERA.half);
  const fov = `M${r1(lens.x)} ${r1(lens.y)}L${hi.x} ${hi.y}`;
  const fovFill = `M${r1(lens.x)} ${r1(lens.y)}L${lo.x} ${lo.y}V${top - over}H${hi.x}L${hi.x} ${hi.y}Z`;
  const hiA = (CAMERA.tilt + CAMERA.half) * RAD;
  const fovAt = (oy - top) * 0.62;
  const fovLab = {
    x: r1(lens.x + fovAt * Math.cos(hiA) - 6 * Math.sin(hiA)),
    y: r1(lens.y - fovAt * Math.sin(hiA) - 6 * Math.cos(hiA)),
    a: -(CAMERA.tilt + CAMERA.half),
  };
  // Elevation scale around the pivot.
  const scaleR = 120 * L.art;
  let scale = `M${r1(ox + scaleR * Math.cos(-2 * RAD))} ${r1(oy + scaleR * Math.sin(2 * RAD))}A${r1(scaleR)} ${r1(scaleR)} 0 0 0 ${r1(ox + scaleR * Math.cos(42 * RAD))} ${r1(oy - scaleR * Math.sin(42 * RAD))}`;
  const scaleLabels: { x: number; y: number; t: string }[] = [];
  for (let d = 0; d <= 40; d += 2) {
    const c = Math.cos(d * RAD), sn = Math.sin(d * RAD), len = (d % 10 ? 3.5 : 7) * (L.wide ? 1 : 0.7);
    scale += `M${r1(ox + scaleR * c)} ${r1(oy - scaleR * sn)}L${r1(ox + (scaleR + len) * c)} ${r1(oy - (scaleR + len) * sn)}`;
    if (d % 10 === 0 && d > 0) scaleLabels.push({ x: r1(ox + (scaleR + 17) * c), y: r1(oy - (scaleR + 17) * sn + 4), t: `${d}°` });
  }
  return { rings, ticks, labels, fov, fovFill, fovLab, lens, scale, scaleLabels };
}

const views = LAYOUTS.map((L) => ({ L, G: geom(L, S, det), B: backdrop(L) }));

const cells = [
  { k: "range", label: "range", unit: "m" },
  { k: "tof", label: "time of flight", unit: "s" },
  { k: "lead", label: "lead", unit: "" },
  { k: "elev", label: "elevation", unit: "" },
  { k: "drop", label: "drop", unit: "m" },
  { k: "speed", label: "speed on arrival", unit: "m/s" },
];

const label = `A side view of a counter-drone engagement, with a camera view and instruments. In the illustrated case the drone is ${fx(S.range, 0)} metres away and flying at ${TARGET.speed} metres per second; the round takes ${fx(S.tof, 2)} seconds to arrive, so the mount aims ${fx(S.lead / RAD, 1)} degrees above the line of sight.`;
const aria = `Side view, to scale. A mount on the left tracks a drone ${fx(S.range, 0)} m away with a camera. The solved trajectory leaves the barrel at ${fx(S.theta / RAD, 1)} degrees, ${fx(S.lead / RAD, 2)} degrees above the line of sight, slows from ${GUN.v0} to ${fx(S.vImpact, 0)} m/s, falls ${fx(S.drop, 2)} m below the aim line, and meets the drone ${fx(S.tof, 3)} s later, ${fx(TARGET.speed * S.tof, 1)} m ahead of where the camera saw it. A dashed line shows the same shot without drag, which would be far past the drone by then. The solver took ${S.n} passes before its correction fell below one millimetre.`;
---

<Figure
  name="intercept"
  n={n}
  size="stage"
  screen
  title="Aiming at where the drone will be"
  label={label}
  readout={readoutFlight(S, S.tof, S.drop)}
>
  {views.map(({ L, G, B }) => {
    const C = L.cam, P = L.plot, I = L.ins, k = L.key, w = L.wide;
    const pad = w ? 14 : 10;
    const hit = w ? { x: 244, y: 0, w: L.right - 244, h: L.oy } : { x: 64, y: 0, w: L.right - 64, h: L.oy + 4 };
    return (
      <svg
        class:list={["ic", `ic-${k}`]}
        viewBox={`0 0 ${L.W} ${L.H}`}
        role="img"
        aria-label={aria}
        data-view={k}
      >
        <defs>
          <clipPath id={`ic-sky-${k}`}><rect x="0" y={L.top} width={L.right} height={L.oy - L.top} /></clipPath>
          <clipPath id={`ic-cam-${k}`}><rect x={C.x0} y={C.y0} width={C.x1 - C.x0} height={C.y1 - C.y0} /></clipPath>
          <g id={`ic-drone-${k}`}>
            <line class="ic-g-blade" x1="-16.5" x2="-3.5" y1="-7.3" y2="-7.3" />
            <line class="ic-g-blade" x1="3.5" x2="16.5" y1="-7.3" y2="-7.3" />
            <path class="ic-g-line" d="M-5.5 -1.2L-10 -3.4M5.5 -1.2L10 -3.4M-3 2.9l-1.8 4.2M3 2.9l1.8 4.2M-6.6 7.1h3.6M3 7.1h3.6" />
            <path class="ic-g-fill" d="M-11.3 -6.2h2.6v2.9h-2.6zM8.7 -6.2h2.6v2.9h-2.6z" />
            <rect class="ic-g-fill" x="-7" y="-2.9" width="14" height="5.8" rx="2.7" />
            <circle class="ic-g-fill" cx="-5" cy="4.4" r="1.7" />
          </g>
        </defs>

        <!-- ============================== background: the mount's own coordinates -->
        <g class="ic-bg">
          <path class="ic-fovfill" d={B.fovFill} />
          <path class="hair" d={B.rings} />
          <path class="ic-fov" d={B.fov} />
          <line class="faint" x1={L.ox} x2={L.right} y1={L.oy} y2={L.oy} />
          <path class="faint" d={B.ticks} />
          {B.labels.map((l, i) => (
            <text class="cm ic-ax" x={l.x} y={L.oy + (w ? 20 : 19)} text-anchor="middle">{l.t}{i === B.labels.length - 1 ? " m" : ""}</text>
          ))}
          {w && <text class="ic-lab ic-sec" transform={`translate(${B.fovLab.x} ${B.fovLab.y}) rotate(${B.fovLab.a})`} text-anchor="middle">camera field of view</text>}
          {w && (
            <g class="ic-scale">
              <path class="faint" d="M932 334v8M932 338H1064M1064 334v8" />
              <text class="cm ic-ax" x="998" y="330" text-anchor="middle">10 m</text>
              <text class="ic-lab" x="918" y="342" text-anchor="end">mount and drone drawn <tspan class="cm">10×</tspan> larger</text>
            </g>
          )}
          {!w && <text class="ic-lab ic-note" x={L.right} y={L.oy + 62} text-anchor="end">mount and drone not to scale</text>}
        </g>

        <!-- ============================== the track -->
        <g class="ic-track" clip-path={`url(#ic-sky-${k})`}>
          <line class="ic-trk" data-k="trk" {...G.a.trk} />
          <path class="ic-det" data-k="det" {...G.a.det} />
          <line class="ic-prd" data-k="prd" {...G.a.prd} />
        </g>
        {w && <line class="ic-leader ic-dot" data-k="hext" {...G.a.hext} />}
        {w && <path class="ic-leader" data-k="hdim" {...G.a.hdim} />}

        <!-- ============================== rays and trajectories -->
        <g class="ic-rays" clip-path={`url(#ic-sky-${k})`}>
          <path class="ic-wedge" data-k="wedge" {...G.a.wedge} />
          <line class="ic-los" data-k="los" {...G.a.los} />
          <path class="ic-ghost" data-k="ghost" {...G.a.ghost} />
          <line class="ic-aim" data-k="aim" {...G.a.aim} />
          <path class="ic-dim" data-k="la" {...G.a.la} />
          {Array.from({ length: MAX_ITER }, (_, i) => (
            <path class="ic-cand" data-k={`cand${i}`} pathLength="1" {...G.a[`cand${i}`]} />
          ))}
          <path class="ic-arcp" data-k="arcP" pathLength="1" {...G.a.arcP} />
          <path class="ic-arcf" data-k="arcF" pathLength="1" {...G.a.arcF} />
          <path class="ic-tks" data-k="tks" {...G.a.tks} />
          {Array.from({ length: MAX_ITER }, (_, i) => (
            <path class="ic-cpt" data-k={`cpt${i}`} {...G.a[`cpt${i}`]} />
          ))}
          <circle class="ic-gdot" data-k="gdot" r={w ? 3 : 2.6} {...G.a.gdot} />
        </g>

        <!-- ============================== the mount (not to the sky's scale) -->
        <g class="ic-tur" transform={`translate(${L.ox} ${L.oy}) ${artScale(L)}`}>
          <path class="ic-d" d="M-72 104.5H72" />
          <path class="ic-h" d={Array.from({ length: 15 }, (_, i) => `M${-63 + i * 9} 104.5l-5.5 6.5`).join("")} />
          <path class="ic-b" d="M-8.8 62.5L-5.6 65.6L-53 104H-58.5ZM8.8 62.5L5.6 65.6L53 104H58.5ZM-1.9 68H1.9L6.6 104H2.4Z" />
          <path class="ic-i" d="M-63 104H-48M48 104H63M-1 104H10" />
          <rect class="ic-b" x="-4.5" y="44" width="9" height="16" />
          <path class="ic-b" d="M-10 58H10L7.5 68H-7.5Z" />
          <rect class="ic-b" x="-33" y="33.5" width="14" height="9" rx="2" />
          <rect class="ic-b" x="-20" y="31" width="40" height="13" rx="3" />
          <path class="ic-d" d="M-20 37.5H20M-28 33.5V42.5" />
          <!-- the camera rides a fixed post behind the rifle -->
          <path class="ic-b" d="M-17.2 31V-42h4.4V31z" />
          <g transform="rotate(-18 -9 -47)">
            <rect class="ic-b" x="2" y="-51.5" width="6.2" height="9" rx="1.4" />
            <rect class="ic-b" x="-20" y="-53.5" width="22" height="13" rx="2.5" />
            <path class="ic-d" d="M-3.5 -53.5V-40.5" />
            <circle class="ic-camled" cx="-15.4" cy="-49.4" r="1.3" />
          </g>
          <!-- the rifle turns on the tilt axis -->
          <g class="ic-rifle" data-k="rifle" {...G.a.rifle}>
            <path class="ic-b" d="M-24 -5.5L-33 -4Q-38 -3.2 -38 0.5V4.2Q-38 6.5 -35 6.6L-24 6.5Z" />
            <rect class="ic-b" x="23" y="3.4" width="36" height="6.6" rx="3.3" />
            <circle class="ic-b" cx="62.4" cy="6.7" r="2.5" />
            <rect class="ic-b" x="22" y="-2.1" width="46" height="4.2" />
            <rect class="ic-b" x="64" y="-3.7" width="24" height="7.4" rx="2.2" />
            <rect class="ic-b" x="10.5" y="-9.6" width="10" height="3.4" rx="1" />
            <rect class="ic-b" x="-24" y="-6.5" width="48" height="13" rx="2.2" />
            <path class="ic-d" d="M70 -3.7V3.7M76 -3.7V3.7M82 -3.7V3.7M35 -2.1V3.4M49 -2.1V3.4M53 3.4V10M13 -1.5H20M-17 -6.5V6.5" />
            <path class="ic-ptr" d="M118 0L111 -3V3Z" />
            <circle class="ic-puff" data-k="puff" cx="91" cy="0" r="2" opacity="0" />
          </g>
          <path class="ic-b" d="M-11 31L-8.5 5A10 10 0 1 1 8.5 5L11 31Z" />
          <circle class="ic-b2" r="4.6" />
          <path class="ic-d" d="M-2.4 0H2.4M0 -2.4V2.4" />
        </g>
        <path class="ic-d" d={B.scale} />
        {w && B.scaleLabels.map((l) => <text class="cm ic-ax ic-sec" x={l.x} y={l.y} text-anchor="middle">{l.t}</text>)}

        <!-- ============================== markers -->
        <g class="ic-marks">
          <circle class="ic-pulse" data-k="pulse" r={L.ring} {...G.a.pulse} opacity="0" />
          <g class="ic-ring" data-k="ring" {...G.a.ring}>
            <circle r={L.ring} />
            <path d={[45, 135, 225, 315].map((d) => `M${r1((L.ring + 2.5) * Math.cos(d * RAD))} ${r1((L.ring + 2.5) * Math.sin(d * RAD))}L${r1((L.ring + (w ? 8 : 5.5)) * Math.cos(d * RAD))} ${r1((L.ring + (w ? 8 : 5.5)) * Math.sin(d * RAD))}`).join("")} />
          </g>
          <use class="ic-drone ic-out" href={`#ic-drone-${k}`} data-k="dD" {...G.a.dD} opacity="0" />
          <line class="ic-tail" data-k="tail" x1={G.a.rnd.cx} x2={G.a.rnd.cx} y1={G.a.rnd.cy} y2={G.a.rnd.cy} opacity="0" />
          <use class="ic-drone" href={`#ic-drone-${k}`} data-k="dr" {...G.a.dr} />
          <circle class="ic-rnd" data-k="rnd" r={w ? 3.2 : 2.8} {...G.a.rnd} />
        </g>

        <!-- ============================== annotation -->
        <g class="ic-ann">
          {w && <path class="ic-leader" data-k="dlead" {...G.a.dlead} />}
          {w && (
            <text class="ic-lab ic-callout" data-k="il" text-anchor="end" {...G.a.il}>intercept at <tspan class="cm" data-t="tofL">{G.t.tofL}</tspan><tspan class="cm"> s</tspan></text>
          )}
          {w && (
            <text class="ic-lab" data-k="dl" text-anchor="end" {...G.a.dl}>drop <tspan class="cm" data-t="dropL">{G.t.dropL}</tspan><tspan class="cm"> m</tspan></text>
          )}
          <text class="ic-lab" data-k="ll" {...G.a.ll}>lead <tspan class="cm" data-t="leadL">{G.t.leadL}</tspan><tspan class="cm">°</tspan></text>
          {w && (
            <text class="ic-lab ic-sec" data-k="losl" text-anchor="middle" {...G.a.losl}>line of sight <tspan class="cm" data-t="rangeL">{G.t.rangeL}</tspan><tspan class="cm"> m</tspan></text>
          )}
          {w && (
            <text class="ic-lab ic-sec" data-k="aiml" text-anchor="middle" {...G.a.aiml}>aim line <tspan class="cm" data-t="elevL">{G.t.elevL}</tspan><tspan class="cm">°</tspan></text>
          )}
          {w && (
            <text class="ic-lab ic-acc ic-sec" data-k="tkl" text-anchor="middle" {...G.a.tkl}><tspan class="cm">{TICK} s</tspan> apart</text>
          )}
          <text class="ic-lab ic-red" data-k="gl" text-anchor="end" {...G.a.gl}>no drag</text>
          <path class="ic-varr" data-k="varr" {...G.a.varr} />
          <text class="ic-lab" data-k="vl" {...G.a.vl}><tspan class="cm">{TARGET.speed} m/s</tspan></text>
          {w && <text class="ic-lab ic-sec" data-k="tl" text-anchor="middle" {...G.a.tl}>one detection per frame</text>}
          {w && <text class="ic-lab ic-hint" data-k="hint" {...G.a.hint}>drag to move</text>}
          {!w && <text class="ic-lab ic-hint" x={L.right} y={L.oy + 42} text-anchor="end">drag the drone</text>}
          {w && <text class="ic-lab ic-sec" data-k="hl" text-anchor="end" {...G.a.hl}><tspan class="cm" data-t="height">{G.t.height}</tspan><tspan class="cm"> m</tspan></text>}
          <text class="ic-lab ic-replay" x={w ? C.x + C.w + 14 : 8} y={L.top + (w ? 17 : 13)} opacity="0">replay at <tspan class="cm">¼</tspan> speed</text>
        </g>

        <!-- ============================== what the camera sees -->
        <g class="ic-cam">
          {w && <path class="ic-leader ic-feed" d={`M${r1(L.ox - 11 * L.art)} ${r1(L.oy - 56 * L.art)}V${C.y + C.h + 1}`} />}
          {w && <g class="ic-pk"></g>}
          <rect class="ic-panel" x={C.x + 0.5} y={C.y + 0.5} width={C.w - 1} height={C.h - 1} rx="8" />
          <text class="ic-lab ic-title" x={C.x + pad} y={C.y + (w ? 21 : 23)}>camera<tspan class="ic-sub">{w ? ", zoomed on the drone" : ", zoomed in"}</tspan></text>
          <path class="hair" data-k="cgrid" {...G.a.cgrid} />
          <line class="faint" x1={C.x0} x2={C.x0} y1={C.y0} y2={C.y1} />
          <path class="faint" data-k="ctape" {...G.a.ctape} />
          {Array.from({ length: 7 }, (_, i) => (
            <text class="cm ic-ax" data-k={`ctl${i}`} x={C.x0 - 9} text-anchor="end" {...G.a[`ctl${i}`]}><tspan data-t={`ctl${i}`}>{G.t[`ctl${i}`]}</tspan></text>
          ))}
          <g clip-path={`url(#ic-cam-${k})`}>
            <line class="hair" x1={C.cx} x2={C.cx} y1={C.y0} y2={C.y1} />
            <line class="ic-scan" x1={C.x0} x2={C.x1} y1={C.y0} y2={C.y0} opacity="0" />
            <path class="ic-cdet" data-k="ctrail" {...G.a.ctrail} />
            <g class="ic-ccross" data-k="ccross" {...G.a.ccross}>
              <path d={`M${C.x0 + 6} 0H${C.cx - 10}M${C.cx + 10} 0H${C.x1 - 6}M${C.cx} -5V-13`} />
              <circle cx={C.cx} cy="0" r="1.4" />
            </g>
            <path class="ic-dim" data-k="cbr" {...G.a.cbr} />
            <path class="ic-dim" data-k="cdb" {...G.a.cdb} />
            <g class="ic-ring" data-k="cring" {...G.a.cring}>
              <circle r="5" />
              <path d="M5.3 5.3L8.5 8.5M-5.3 5.3L-8.5 8.5M5.3 -5.3L8.5 -8.5M-5.3 -5.3L-8.5 -8.5" />
            </g>
            <g class="ic-cbox" data-k="cbox" {...G.a.cbox}>
              <use class="ic-drone ic-mini" href={`#ic-drone-${k}`} transform="scale(0.5)" />
              <path d="M-11 -4.5V-8H-7M7 -8H11V-4.5M11 4.5V8H7M-7 8H-11V4.5" />
            </g>
            <circle class="ic-rnd" data-k="crnd" r="2.4" {...G.a.crnd} />
          </g>
          <text class="ic-lab" data-k="cll" x={C.x0 + 9} {...G.a.cll}>barrel</text>
          <text class="ic-lab" data-k="cdl" x={C.cx - 17} text-anchor="end" {...G.a.cdl}>drone</text>
          <text class="ic-lab" data-k="cdt" x={C.cx - 27} text-anchor="end" {...G.a.cdt}>drop</text>
          <text class="ic-lab" data-k="cbt" x={C.bx + 7} {...G.a.cbt}>lead</text>
          <text class="cm ic-ax ic-strong" data-k="cbv" x={C.bx + 7} {...G.a.cbv}><tspan data-t="leadC">{G.t.leadC}</tspan>°</text>
        </g>

        <!-- ============================== the solver -->
        <g class="ic-solver">
          {!w && <rect class="ic-panel" x={P.x + 0.5} y={P.y + 0.5} width={P.w - 1} height={P.h - 1} rx="8" />}
          <text class="ic-lab ic-title" x={P.x + (w ? 0 : pad)} y={P.y + (w ? 12 : 23)}>solver<tspan class="ic-sub">{w ? ", correction per pass" : ", correction"}</tspan></text>
          {[1, 0.1, 0.01, 0.001].map((m) => (
            <>
              <path class={m === 0.001 ? "ic-tol" : "hair"} d={`M${P.x0 - 12} ${r1(plotY(L, m))}H${P.x + P.w - (w ? 2 : pad)}`} />
              {(m === 1 || m === 0.001 || (!w && m === 0.01)) && <text class="cm ic-ax" x={P.x0 - 17} y={r1(plotY(L, m) + 4)} text-anchor="end">{m === 1 ? "1 m" : m === 0.01 ? "1 cm" : "1 mm"}</text>}
            </>
          ))}
          <path class="ic-sline" data-k="sline" {...G.a.sline} />
          {Array.from({ length: MAX_ITER }, (_, i) => (
            <>
              <circle class="ic-sd" data-k={`sd${i}`} r={w ? 2.6 : 3.2} {...G.a[`sd${i}`]} />
              <text class="cm ic-ax" data-k={`sn${i}`} x={P.x0 + i * P.dx} y={r1(plotY(L, 1e-4) + (w ? 20 : 24))} text-anchor="middle" {...G.a[`sn${i}`]}>{i + 1}</text>
            </>
          ))}
          <circle class="ic-slast" data-k="slast" r={w ? 5.2 : 6.4} {...G.a.slast} />
        </g>

        <!-- ============================== instruments -->
        <g class="ic-ins">
          {cells.map((c, i) => {
            const col = i % I.cols, row = Math.floor(i / I.cols);
            const x = r1(I.x + col * I.cw), y = I.y + row * I.ch;
            return (
              <g class="ic-cell" data-cell={c.k} transform={`translate(${x} ${y})`}>
                {(w || col > 0) && <line class="hair" x1="0.5" x2="0.5" y1="2" y2={I.ch - 4} />}
                {!w && row > 0 && <line class="hair" x1={col ? 0 : 0} x2={I.cw} y1="0.5" y2="0.5" />}
                <text class="ic-lab ic-k" x={pad} y={w ? 14 : 24}>{c.label}</text>
                <text class="cm ic-v" x={pad} y={w ? 50 : 59}><tspan data-t={c.k}>{G.t[c.k]}</tspan>{c.unit && <tspan class="ic-u" dx="3">{c.unit}</tspan>}</text>
                <text class="ic-lab ic-s" x={pad} y={w ? 76 : 82}>
                  {c.k === "range" && <>meets at <tspan class="cm" data-t="rangeI">{G.t.rangeI}</tspan><tspan class="cm"> m</tspan></>}
                  {c.k === "tof" && <>no drag <tspan class="cm" data-t="tofVac">{G.t.tofVac}</tspan><tspan class="cm"> s</tspan></>}
                  {c.k === "lead" && <><tspan class="cm" data-t="moved">{G.t.moved}</tspan><tspan class="cm"> m</tspan> ahead</>}
                  {c.k === "elev" && <>sight line <tspan class="cm" data-t="los">{G.t.los}</tspan><tspan class="cm">°</tspan></>}
                  {c.k === "drop" && <>no drag <tspan class="cm" data-t="dropVac">{G.t.dropVac}</tspan><tspan class="cm"> m</tspan></>}
                  {c.k === "speed" && <>from <tspan class="cm">{GUN.v0} m/s</tspan></>}
                </text>
              </g>
            );
          })}
        </g>

        <!-- ============================== the reader's hand -->
        <rect class="ic-field" x={r1(L.ox + BOUNDS.x0 * L.s)} y={r1(L.oy - BOUNDS.y1 * L.s)} width={r1((BOUNDS.x1 - BOUNDS.x0) * L.s)} height={r1((BOUNDS.y1 - BOUNDS.y0) * L.s)} rx={w ? 10 : 6} />
        <g class="ic-cur" opacity="0">
          <path d="M-7 0H-2.5M2.5 0H7M0 -7V-2.5M0 2.5V7" />
          <text class="cm ic-ax ic-lab" x="11" y="-9"></text>
        </g>
        <circle class="ic-grab" data-k="grab" r={w ? 31 : 24} {...G.a.grab} />
        <rect class="ic-hit" x={hit.x} y={hit.y} width={hit.w} height={hit.h} />
        <circle class="ic-focus" data-k="focus" r={w ? 31 : 24} {...G.a.focus} />
      </svg>
    );
  })}
  <Fragment slot="caption">
    The camera sees where the drone is now. The round takes time to get there, slows in the air and falls on the way, so the mount has to aim ahead and above. The solver guesses a flight time, predicts where the drone will be, corrects its aim, and repeats until the two meet. Drag the drone to solve another shot. Speeds and distances here are illustrative, not the team's hardware.
  </Fragment>
</Figure>

