        <g class="aseg" data-i={i}>
          <line class="seg-a" x1={aSeg[i].x0} x2={aSeg[i].x1} y1={C.y2 + 20} y2={C.y2 + 20} />
          <text class="seg-t m-name" x={mSeg[i].cx} y={C.y2 + 20} text-anchor="middle" opacity="0">{manual[i].k}</text>
          <text class="seg-t a-name" x={aSeg[i].cx} y={C.y2 + 20} text-anchor="middle">{s.k}</text>
        </g>
      ))}
      <g class="saved">
        <text class="cm pct" x={aEnd + 6} y={C.y2 + 24}>30%</text>
        <line class="dash sv" x1={aEnd + 40} x2={W - 4} y1={C.y2 + 20} y2={C.y2 + 20} />
        <path class="faint" d={`M${W - 0.5} ${C.y2 + 12}v16`} />
      </g>
      </g>
    </g>
  </svg>
  <Fragment slot="caption">Playwright scrapers read competitor catalogs into pricing data. A Node.js and Express endpoint renders each Code 128 label and sends it to the label printer through CUPS, which cut manual processing time by 70%. Items and prices shown are examples.</Fragment>
