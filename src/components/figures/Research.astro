---
// Fig: three results from the binary-star papers, as small multiples, each
// with an inset. The plot is rendered in two layouts (insets beside the
// panels, or under them on phones); CSS shows one. Every curve is computed
// at build time from the papers' formulas; the script only reveals it.
import Figure from "../Figure.astro";
import ResearchPlot from "./ResearchPlot.astro";
---

<Figure
  name="research"
  n={8}
  title="Three results"
  label="Three results on mass transfer in binary stars, one panel per paper"
  readout=""
>
  <ResearchPlot mode="wide" />
  <ResearchPlot mode="narrow" />
  <Fragment slot="caption">Each panel is one paper's closed-form result, drawn for mass ratios 0.4, 1 and 2 in red, green and violet. Drag across panel (c) or pick a <span class="mi">q</span> to see which way the two stars' separation moves.</Fragment>
</Figure>

<style is:global>
  /* Text grows as the plate shrinks, so labels stay near 10px on a phone.
     --u is one CSS px at desktop width and about 1.9 at a 390px viewport. */
  .fig svg.rs-w {
    --u: clamp(1.06px, calc(3.49px - 0.4036vw), 1.914px);
  }
  /* The narrow layout is 400 wide, so it needs far less growth. */
  .fig .plot svg.rs-n {
    --u: clamp(0.82px, calc(2.237px - 0.253vw), 1.45px);
    display: none;
  }
  @media (max-width: 559.98px) {
    .fig .plot svg.rs-w { display: none; }
    .fig .plot svg.rs-n { display: block; }
  }
  .fig svg.rs text { font-size: calc(11 * var(--u)); }
  .fig svg.rs text.cm { font-size: calc(11.5 * var(--u)); }
  .fig svg.rs text.m { font-size: calc(13.5 * var(--u)); }
  .fig svg.rs text.plab { font-size: calc(11 * var(--u)); fill: var(--ink-3); }
  .fig svg.rs tspan.pl { font-family: var(--cm); fill: var(--ink); font-size: 1.05em; }
  .fig svg.rs tspan.k { fill: var(--ink); font-weight: 500; }
  .fig svg.rs tspan.u { font-family: var(--cm); font-style: normal; }
  .fig svg.rs tspan.sb { font-family: var(--cm); font-style: normal; font-size: 0.74em; }
  .fig svg.rs .psub text { font-size: calc(11 * var(--u)); fill: var(--ink-2); }
  .fig svg.rs tspan.sbs { font-family: var(--cm); font-size: 0.92em; }
  .fig svg.rs tspan.ann-in { font-family: var(--sans); font-style: normal; font-size: 0.78em; fill: var(--ink-3); }
  .fig svg.rs tspan.mi { font-family: var(--math); font-style: italic; font-size: 1.16em; }
  .fig svg.rs text.ann { font-size: calc(10.5 * var(--u)); }
  .fig svg.rs text.hd { fill: var(--ink-3); }
  .fig svg.rs .c-red { fill: var(--s-red); }
  .fig svg.rs .c-green { fill: var(--s-green); }
  .fig svg.rs .c-violet { fill: var(--s-violet); }
  .fig svg.rs .lc { fill: none; stroke-width: 2; stroke-dasharray: 7 14; stroke-linecap: butt; }
  .fig svg.rs .sw { stroke-width: 2; }
  .fig svg.rs .lead { fill: none; stroke: var(--ink-3); stroke-width: 1; }
  .fig svg.rs .lead-dot { fill: var(--ink-3); }
  .fig svg.rs .dotted { stroke: var(--ink-3); stroke-width: 1; stroke-dasharray: 1 3; stroke-linecap: round; }
  .fig svg.rs .zbox { fill: none; stroke: var(--ink-3); stroke-width: 1; }
  .fig svg.rs .zcon { fill: none; stroke: var(--ink-4); stroke-width: 1; stroke-dasharray: 2 3; }
  .fig svg.rs .zring { fill: none; stroke: var(--accent); stroke-opacity: 0.4; stroke-width: 1; }
  .fig svg.rs .zbrkx { fill: none; stroke: var(--panel-2); stroke-width: 3; }
  .fig svg.rs .drop { stroke-opacity: 0.45; stroke-width: 1; stroke-dasharray: 2 3; }
  .fig svg.rs .below { fill-opacity: 0.4; }
  .fig svg.rs .cl { stroke-width: 1.25; }
  .fig svg.rs .cl.sel { stroke-width: 2; }
  .fig svg.rs .curl { stroke: var(--ink-4); stroke-width: 1; }
  .fig svg.rs .cd { stroke: var(--panel); stroke-width: 1; }
  .fig svg.rs .cd.sel { stroke: var(--ink); stroke-width: 1.25; }
  .fig svg.rs .chit { fill: transparent; stroke: none; }
  .fig svg.rs .chip .cbar { stroke-width: 2; opacity: 0; }
  .fig svg.rs .chip.on .cbar { opacity: 1; }
  .fig svg.rs .chip:not(.on) text { fill-opacity: 0.55; }
  .fig svg.rs[data-live] .chip { cursor: pointer; }
  .fig svg.rs .com { fill: none; stroke: var(--ink-3); stroke-width: 1; }
  .fig svg.rs .orb { fill: none; stroke: var(--ink-4); stroke-width: 1; }
  .fig svg.rs .aft { fill: none; stroke: var(--accent); stroke-width: 1; stroke-dasharray: 3 3; stroke-opacity: 0.7; }
  .fig svg.rs .rip { fill: none; stroke: var(--accent); stroke-width: 1.25; }
  .fig svg.rs .barr { fill: none; stroke: var(--accent); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .fig svg.rs .strm { fill: none; stroke: var(--ink-3); stroke-width: 1; stroke-dasharray: 1.5 3; stroke-linecap: round; }
  .fig svg.rs .st1 { fill: var(--ink); }
  .fig svg.rs .st2 { fill: var(--panel); stroke: var(--ink); stroke-width: 1.25; }
  .fig svg.rs text.bverd { fill: var(--accent); }
  .fig svg.rs .hit { fill: transparent; stroke: none; pointer-events: none; }
  .fig svg.rs[data-live] .hit { pointer-events: all; cursor: ew-resize; touch-action: pan-y; }
  .fig svg.rs .hit:focus { outline: none; }
  .fig svg.rs .hit:focus-visible { stroke: var(--accent); stroke-width: 1; }
  .fig .mi { font-family: var(--math); font-style: italic; }
  .fig figcaption em { font-style: normal; color: var(--ink-2); }
  .fig figcaption sub { font-size: 0.72em; }
</style>
