---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Section from "../components/Section.astro";
import Passage from "../components/Passage.astro";
import Entry from "../components/Entry.astro";
import Hero from "../components/Hero.astro";
import Cosmos from "../components/Cosmos.astro";
import About from "../components/About.astro";
import Footer from "../components/Footer.astro";
import Palette from "../components/Palette.astro";
import { paper } from "../data/paper";

// Distinctions, most recent first; contest results follow in the figure beside them.
type Row = { what: string; detail: string; when?: string };
const record: { group: string; rows: Row[] }[] = [
  {
    group: "Honours",
    rows: [
      { what: "Schulich Leader Scholarship", detail: "$100K+, to study computer science at the University of Waterloo", when: "2026" },
      { what: "NeurIPS 2026 workshops", detail: "Sole author; accepted at both workshops it was sent to", when: "2026" },
      { what: "Best Manuscript", detail: "Journal of High School Science, for the second binary-star paper", when: "2026" },
      { what: "Best Non-GenAI Hack", detail: "JAMHacks 10, for Daedalus", when: "2026" },
      { what: "Featured", detail: "Chrome Web Store, for Drift", when: "2026" },
    ],
  },
  {
    group: "Competitions",
    rows: [
      { what: "USACO", detail: "Platinum, with a perfect 1,000 on Gold" },
      { what: "AAPT PhysicsBowl", detail: "1st in Canada, 7th in the world" },
      { what: "Sir Isaac Newton Exam", detail: "4th in Canada, 9th in the world" },
      { what: "AIME", detail: "Qualified three times" },
    ],
  },
  {
    group: "Elsewhere",
    rows: [{ what: "Tokenboard", detail: "1st worldwide, August 2026; over 100 billion tokens with coding agents" }],
  },
];
---

<Base
  jsonld={[
    {
      "@context": "https://schema.org",
      "@type": "ScholarlyArticle",
      headline: `${paper.title}: ${paper.subtitle}`,
      author: { "@id": "https://yuzeli.ca/#jerry" },
      datePublished: "2026",
      url: `https://yuzeli.ca${paper.href}`,
      isPartOf: { "@type": "Event", name: `NeurIPS 2026 workshops: ${paper.workshops[0].full}; ${paper.workshops[1].full}` },
    },
  ]}
>
  <Cosmos cover />
  <Header cover />

  <main id="top">
    <Hero />

    <About />

    <Passage
      reach={0.08}
      orbit="jupiter"
      n={1}
      place="5.2 AU · Jupiter's orbit"
      line="Everything in the swarm was mined out here and hauled in, one load at a time. That is how I like to build: ship it, then keep shipping."
      log="Jupiter's Trojans, two clouds of asteroids that lead and trail the planet by 60 degrees, may hold about as many large bodies as the main belt. The tugs in this scene carry cargo down to the swarm on Hohmann transfers, about fifteen months each way from the belt. What goes out goes up the beam: light sails, metres across and weighing grams, pushed by light alone. Breakthrough Starshot proposed driving such sails with a 100-gigawatt laser to a fifth of the speed of light in minutes; a beam with the Sun's output behind it could push far heavier ones."
    />

    <Section id="work" index={2} title="Work" lede="Software people use: AI video at a YC startup, a counter-drone turret, and a math judge in 182 countries.">
      <Entry title="Mathos AI" stat="YC W24 · AI video lessons" href="https://mathos.ai" role="Software engineering intern" period="2026 to now">
        <p>Shipped video export, the email pipeline, and an MCP server that lets people make Mathos lessons from inside ChatGPT and Claude.</p>
      </Entry>
      <Entry title="Waterloo Defence" stat="Counter-UAS · DND CUAS Sandbox 2027" href="https://waterloodefence.ca" role="Software Lead" period="2026 to now">
        <p>Leading the software for a student-built autonomous counter-drone turret: finding the drone, tracking it, and aiming ahead of it.</p>
      </Entry>
      <Entry title="TopsOJ" stat="100,000+ users · 182 countries" href="https://topsoj.com" role="Founder" period="2023 to now">
        <p>A judge for competitive math I started in high school. Over 100,000 people in 182 countries have used it.</p>
      </Entry>
      <Entry title="Quoted Tech Computers" stat="−70% manual processing" role="Software engineering intern" period="Summer 2025">
        <p>Automated label printing and competitor pricing, cutting manual processing time by 70%.</p>
      </Entry>
    </Section>

    <Passage
      reach={0.25}
      orbit="saturn"
      n={2}
      place="9.5 AU · Saturn's orbit"
      line="Nothing out here is drawn by hand: every orbit is solved from its real elements. Research is where I check an answer instead of trusting it."
      log="Saturn takes 29.5 years to go round the Sun. Every body in this scene, down to each of the 60,000 collectors, moves on its own Kepler orbit, solved on the graphics card every frame. Distances and periods are to scale; sizes are not."
    />

    <Section id="research" index={3} title="Research" lede="Four sole-authored papers, on coding agents and on binary stars.">
      <Entry title={paper.title} stat="NeurIPS 2026 · Two workshops" href={paper.href} role="NeurIPS 2026 workshops" period="2026">
        <p>Do more coding agents fix more bugs? In controlled experiments, trees of agents spent 6 to 12 times the tokens for no gain.</p>
      </Entry>
      <Entry title="Mass transfer in binary stars" stat="Three papers · Best Manuscript" role="With Dr. Alexander Mushtukov, Oxford" period="2024 to 2026">
        <p>Three papers showing that gas passed between two stars shrinks their orbit, where the textbook says it usually widens.</p>
        <ol class="papers">
          <li><a class="ln" href="https://doi.org/10.3847/2515-5172/ae4513" target="_blank" rel="noopener">Research Notes of the AAS</a></li>
          <li><a class="ln" href="https://doi.org/10.64336/001c.159153" target="_blank" rel="noopener">Journal of High School Science</a></li>
          <li><a class="ln" href="https://arxiv.org/abs/2608.19107" target="_blank" rel="noopener">arXiv</a></li>
        </ol>
      </Entry>
    </Section>

    <Passage
      reach={0.57}
      orbit="neptune"
      n={3}
      place="30 AU · Neptune, and the Kuiper belt"
      line="Past Neptune are thousands of small, cold worlds, each unlike the next. These are the small things I built because I wanted them."
      log="Neptune is 30 times as far from the Sun as the Earth; sunlight takes about four hours to get here. Beyond it the Kuiper belt runs out to about 50 AU, with more than 100,000 bodies over 100 km across by most estimates."
    />

    <Section id="projects" index={4} title="Projects" lede="Hackathon builds and things I made because I wanted them.">
      <Entry title="Cardboard Cockpit" href="https://devpost.com/software/wad" role="Hack the North" period="2026">
        <p>A flight simulator you fly from a cardboard cockpit and a webcam.</p>
      </Entry>
      <Entry title="Daedalus" href="https://devpost.com/software/glebber-stometric" role="JAMHacks 10, Best Non-GenAI Hack" period="2026">
        <p>Sculpting in 3D with your hands in the air.</p>
      </Entry>
      <Entry title="Drift" href="https://chromewebstore.google.com/detail/drift/agihdlojchhjpflceecmfknffggofdhf" role="Featured on the Chrome Web Store" period="2026">
        <p>Turns the wait for an AI's answer into a short, focused break.</p>
      </Entry>
      <Entry title="Worldline Engine" href="https://github.com/fireheartjerry/worldline-engine" role="Simulation" period="2026">
        <p>A universe simulator where one seed always grows the same universe. The cover of this page grows the same way.</p>
      </Entry>
      <Entry title="Porchlight" href="https://github.com/fireheartjerry/porchlight">
        <p>An aid dispatcher run by agents, which hands anything sensitive to a person.</p>
      </Entry>
      <Entry title="PolyTwist" href="https://github.com/fireheartjerry/PolyTwist">
        <p>Solves and renders twisty puzzles it has never seen.</p>
      </Entry>
    </Section>

    <Passage
      reach={1}
      orbit="heliopause"
      n={4}
      place="140 AU · Past the heliopause"
      line="Looking back, the whole swarm is one gold star. This is how far it has come."
      log="Voyager 1 crossed the heliopause, where the Sun's wind gives way to the gas between the stars, at about 121 AU in 2012. In 1990, from about 40 AU, it turned its camera back and caught the Earth as less than a pixel. The probe here is drawn to its proportions: a 3.7 m dish and a 13 m boom. Sunlight takes about 19 hours to reach this far."
    />

    <Section id="record" index={5} title="Record" lede="Scholarships, papers and contest results.">
      {record.map((g) => (
        <div class="group">
          <p class="group-k readout">{g.group}</p>
          <dl class="record" data-reveal="rows">
            {g.rows.map((r) => (
              <div>
                <dt>{r.what}</dt>
                <dd>{r.detail}</dd>
                {r.when && <dd class="when cm">{r.when}</dd>}
              </div>
            ))}
            {g.group === "Elsewhere" && (
              <div>
                <dt>LinkedIn</dt>
                <dd>9,000+ followers on <a class="ln" href="https://www.linkedin.com/in/fireheartjerry/" target="_blank" rel="noopener">LinkedIn</a></dd>
              </div>
            )}
          </dl>
        </div>
      ))}
    </Section>

    <Passage
      reach={1}
      orbit="seam"
      n={5}
      place="140 AU · A seam in the sky"
      line="Out here the sky breaks along a line. A cosmic string, a flaw in space from the first instant, shows everything behind it twice. From here, the way is home."
      log="Some theories of the early universe leave behind cosmic strings: lines far thinner than a proton, so dense that a stretch tens of kilometres long could weigh as much as the Earth. Space closes round one into a cone with a slice missing, so light passing either side is turned by the same small angle and what lies behind is seen twice. None has been found. The microwave background limits that angle to under about a second of arc; the seam here is drawn thousands of times wider, so it can be seen."
    />
  </main>

  <Footer />
  <Palette />

  <script>
    import "../scripts/page";
    import "../scripts/figures";
  </script>
</Base>

<style>
  .papers {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin-top: 10px;
    font-size: 14.5px;
  }
  .papers a {
    padding-block: 6px;
  }
  .group {
    margin-top: 28px;
  }
  .group-k {
    color: #e6bd7c;
  }
  .record {
    margin: 4px 0 0;
  }
  .record > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 16px;
    padding-block: 11px;
  }
  .record dt {
    grid-column: 1;
    font-size: 17px;
  }
  .record dd {
    grid-column: 1;
    font-size: 14.5px;
    color: var(--ink-3);
  }
  .record .when {
    grid-column: 2;
    grid-row: 1;
    font-size: 14.5px;
    color: var(--ink-3);
  }
</style>
