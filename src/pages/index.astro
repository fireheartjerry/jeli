---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Interlude from "../components/Interlude.astro";
import Sequence from "../components/Sequence.astro";
import Section from "../components/Section.astro";
import Entry from "../components/Entry.astro";
import Hero from "../components/Hero.astro";
import Cosmos from "../components/Cosmos.astro";
import About from "../components/About.astro";
import Footer from "../components/Footer.astro";
import Palette from "../components/Palette.astro";
import Submissions from "../components/figures/Submissions.astro";
import TopsojMap from "../components/figures/TopsojMap.astro";
import TopsojGA from "../components/figures/TopsojGA.astro";
import Export from "../components/figures/Export.astro";
import Quoted from "../components/figures/Quoted.astro";
import Ratings from "../components/figures/Ratings.astro";
import Drift from "../components/figures/Drift.astro";
import Worldline from "../components/figures/Worldline.astro";
import Research from "../components/figures/Research.astro";
import Contests from "../components/figures/Contests.astro";
import Cockpit from "../components/figures/Cockpit.astro";
import Daedalus from "../components/figures/Daedalus.astro";
import Intercept from "../components/figures/Intercept.astro";
import Delegation from "../components/figures/Delegation.astro";
import Landscape from "../components/figures/Landscape.astro";
import topsoj from "../data/topsoj.json";
import { paper } from "../data/paper";

const fmt = (n: number) => n.toLocaleString("en-US");

// Distinctions, most recent first; contest results follow in the figure beside them.
const record = [
  { what: "Schulich Leader Scholarship", detail: "$100K+, to study computer science at the University of Waterloo", when: "2026" },
  { what: "NeurIPS 2026 workshops", detail: "Sole author; accepted at both workshops it was sent to", when: "2026" },
  { what: "Best Manuscript", detail: "Journal of High School Science, for the second binary-star paper", when: "2026" },
  { what: "Best Non-GenAI Hack", detail: "JAMHacks 10, for Daedalus", when: "2026" },
  { what: "Featured", detail: "Chrome Web Store, for Drift", when: "2026" },
  { what: "USACO", detail: "Platinum, with a perfect 1,000 on Gold" },
  { what: "AAPT PhysicsBowl", detail: "1st in Canada, 7th in the world" },
  { what: "Sir Isaac Newton Exam", detail: "4th in Canada, 9th in the world" },
  { what: "AIME", detail: "Qualified three times" },
];
---

<Base
  jsonld={[
    {
      "@context": "https://schema.org",
      "@type": "ScholarlyArticle",
      headline: `${paper.title}: ${paper.subtitle}`,
      author: { "@id": "https://yuzeli.ca/#jerry" },
      datePublished: "2026",
      url: `https://yuzeli.ca${paper.href}`,
      isPartOf: { "@type": "Event", name: `NeurIPS 2026 workshops: ${paper.workshops[0].full}; ${paper.workshops[1].full}` },
    },
  ]}
>
  <Cosmos cover />
  <Header cover />

  <main id="top">
    <Hero />

    <About />

    <Interlude
      kind="wormhole"
      name="A wormhole"
      caption="A tunnel through space, if one could exist, seen from outside as a sphere. Through it, another galaxy, its whole sky squeezed into the ball; around it, our own sky bent by its gravity. General relativity allows them; nothing yet says one could be built or kept open."
    />

    <Section id="work" title="Work" lede="Shipped software: AI video at a YC startup, fire control for a counter-drone turret, and a math judge used in 182 countries.">
      <Entry title="Mathos AI" href="https://mathos.ai" role="Software engineering intern" period="2026 to now" tags="Python, Celery, Remotion, AWS Fargate, SES, Next.js, OAuth 2.0, MCP">
        <p>
          At Mathos (YC W24), which turns math questions into narrated video lessons, I shipped MP4
          export in Python and Remotion, with every render in its own locked-down AWS Fargate sandbox
          behind a Celery queue.
        </p>
        <p>
          I also built the lifecycle email pipeline on SES, an OAuth and MCP server so people can make
          Mathos videos from inside ChatGPT and Claude, and rebuilt how the AI tutor grades each step of
          a student's work.
        </p>
        <Export slot="figure" n={2} />
      </Entry>

      <Entry feature title="Waterloo Defence" href="https://waterloodefence.ca" role="Software Lead" period="2026 to now" tags="Computer vision, tracking, ballistics, MuJoCo">
        <p>
          I lead the software for a University of Waterloo student team building an autonomous
          counter-drone turret: the vision that finds and tracks a small drone, the solver that works out
          where it will be when the shot arrives, and the MuJoCo simulator we test both in.
        </p>
        <p>
          A round takes time to arrive, slows in the air and falls on the way, so the mount has to aim
          ahead of the drone and above it. We are building toward the Department of National Defence's
          2027 CUAS Urban Sandbox.
        </p>
        <Intercept slot="figure" n={3} />
      </Entry>

      <Entry feature title="TopsOJ" href="https://topsoj.com" role="Founder" period="2023 to now" tags="Python, Flask, SQLite, EloMMR">
        <p>
          A judge for competitive math that I started in high school and built in Python and Flask.
          Google Analytics counts over 100,000 users from 182 countries. It holds {fmt(topsoj.totals.publicProblems)} problems
          from the AMC, AIME, CEMC contests, HMMT and our own setters, and has taken over 120,000 submissions.
        </p>
        <p>
          I designed its EloMMR ratings and led a team of 30 setters, developers and organizers,
          with partners including 3Blue1Brown.
        </p>
        <div slot="figure" class="stack">
          <TopsojMap />
          <TopsojGA />
          <div class="pair">
            <Submissions />
            <Ratings />
          </div>
        </div>
      </Entry>

      <Entry title="Quoted Tech Computers" role="Software engineering intern" period="Summer 2025" tags="Node.js, Express, CUPS, Playwright">
        <p>
          I automated barcode label generation and printing in Node.js, which cut manual processing time
          by 70%, and wrote Playwright scrapers that turned competitor catalogs into pricing data.
        </p>
        <Quoted slot="figure" />
      </Entry>
    </Section>

    <Interlude
      kind="hole"
      name="A black hole, out past the edge of this page"
      caption="Drawn the way Interstellar drew Gargantua: the disc of gas almost edge on, brighter on the side coming towards you, and its far side bent up over the shadow by the hole's own gravity. An illustration; nothing like it is near the Sun."
    />

    <Sequence
      scene="horizon"
      name="Falling into a black hole"
      length={12}
      steps={[
        { at: 0, when: "About 70 AU from the centre", title: "A black hole of 100 million suns", scale: "In frame: about 45 AU", text: "Its event horizon is about 590 million kilometres across; in the Sun's place it would reach past the orbit of Mars. Around it turns a thin disc of hot gas. Interstellar's Gargantua was given the same mass. This one is drawn as if it did not spin." },
        { at: 0.11, when: "About 45 AU out", title: "Light bent round it", scale: "In frame: about 35 AU", text: "The disc is seen almost edge on, yet its far side shows above the black and below it: that light has been bent round the hole on its way here. The black is the hole's shadow, about 2.6 times as wide as the horizon itself." },
        { at: 0.22, when: "About 25 AU out", title: "One side brighter", scale: "In frame: about 25 AU", text: "The gas orbits at up to half the speed of light. On the side coming towards us its light is squeezed, bluer and brighter; on the side going away it is redder and dimmer. The gas is drawn at up to about 9,000 degrees, so that it glows in visible light; a real disc like this is far hotter, and glows mostly in ultraviolet." },
        { at: 0.33, when: "About 10 AU out", title: "The last stable orbit", scale: "In frame: about 15 AU", text: "No circular orbit lasts closer in than three times the horizon's radius, about 6 AU from the centre. There the gas goes round in about 12 and a half hours, timed from far away; any closer and it falls in. Around a fast-spinning hole this edge would sit much closer." },
        { at: 0.44, when: "3 AU out", title: "Where light can orbit", scale: "Looking along the orbit", text: "At one and a half times the horizon's radius, light itself can go round in a circle. From here the shadow covers exactly half the sky, with a straight edge. Light sent sideways can come back round: in principle you could see the back of your own head." },
        { at: 0.55, when: "1% above the horizon", title: "Holding still", scale: "Looking straight up", text: "Staying here takes a rocket pushing at more than 100,000 times Earth's gravity. While you hold still, each hour of yours is ten hours outside. The rest of the universe looks ten times bluer, and is squeezed into a circle overhead about 30 degrees across." },
        { at: 0.665, when: "Letting go", title: "Tides", scale: "Looking straight up", text: "Let go and you fall. Gravity pulls a little harder on your feet than on your head; at this horizon the difference is less than a millionth of Earth's gravity, too little to feel. At a black hole of 10 suns it would be about 20 million times Earth's gravity, and would stretch you into a thin strand long before the horizon." },
        { at: 0.77, when: "The event horizon", title: "No way back", scale: "Looking straight up", text: "Crossing it, you feel and see nothing special: no wall, no flash, and starlight keeps falling in after you. But from here on every path into the future, even one of light, leads inward. Nothing you send can reach the outside again." },
        { at: 0.88, when: "Inside", title: "The singularity is a time, not a place", scale: "Looking sideways", text: "Inside, the centre is not somewhere ahead to steer round but a moment in your future, as certain as tomorrow. It comes about 23 minutes after the horizon by your own clock; no rocket could stretch that past 26. What happens there, general relativity cannot say." },
      ]}
    />

    <Section id="research" title="Research" lede="Four papers. One measures when a coding agent should hand work to other agents; three are on how binary stars trade mass.">
      <Entry feature title={paper.title} href={paper.href} role="Sole author. NeurIPS 2026 workshops, Sydney" period="2026" tags="Controlled experiments, agent harnesses, DeepSWE, program verifiers">
        <p>
          In two controlled experiments on DeepSWE repository repairs, comparing arms on the same task
          and grading every fix with an external verifier, trees of 7 and 15 coding agents spent about
          6 and 12 times the tokens of one agent with no resolved gain: every 95% interval includes
          zero or favours the single agent. A coding agent can now spawn other agents, which spawn
          more; I tested whether that buys more correct work, with one model (gpt-5.6-luna) held fixed.
        </p>
        <p>
          The traces show where the work went: sibling agents converged on the same files, and 90% of
          the patches a parent refused collided line for line. Accepted at both workshops it was sent
          to, {paper.workshops[0].short} and {paper.workshops[1].short}.{" "}
          <a class="ln" href={paper.href}>Read the four-minute version</a>.
        </p>
        <Delegation slot="figure" n={9} />
      </Entry>

      <Entry feature title="Mass transfer in binary stars" role="Sole author, supervised by Dr. Alexander Mushtukov, Oxford" period="2024 to 2026" tags="Closed-form analysis, Python simulation">
        <p>
          Three sole-authored papers show, in closed form and in simulation, that when gas spilling
          from one star onto its companion keeps the velocity it left with, the orbit loses angular
          momentum and shrinks, for every mass ratio. The textbook answer is that it usually widens.
        </p>
        <ol class="papers">
          <li>
            <a class="ln" href="https://doi.org/10.3847/2515-5172/ae4513" target="_blank" rel="noopener">Ballistic mass transfer necessarily contracts orbits in binary star systems</a>
            <span>Research Notes of the AAS, February 2026</span>
          </li>
          <li>
            <a class="ln" href="https://doi.org/10.64336/001c.159153" target="_blank" rel="noopener">On the conditions under which instantaneous mass-transfer mappings reproduce conservative limits</a>
            <span>Journal of High School Science, March 2026. Best Manuscript.</span>
          </li>
          <li>
            <a class="ln" href="https://arxiv.org/abs/2608.19107" target="_blank" rel="noopener">The effective velocity of transferred mass</a>
            <span>arXiv, under review at Astronomische Nachrichten</span>
          </li>
        </ol>
        <div slot="figure" class="stack">
          <Landscape n={10} />
          <div class="solo"><Research /></div>
        </div>
      </Entry>
    </Section>

    <Sequence
      scene="supernova"
      name="The death of a massive star"
      length={11}
      steps={[
        { at: 0, when: "10 million years old", title: "A red supergiant", scale: "In frame: about 10 AU", text: "A star twenty times the mass of the Sun, near the end of its life. It has swollen to about a thousand times the Sun's width: in the Sun's place it would swallow every planet out past Mars." },
        { at: 0.1, when: "Its last day", title: "Burning in layers", scale: "In frame: the star, cut open", text: "Inside, it burns in shells: hydrogen on the outside, then helium, carbon, oxygen and neon, and silicon. At the centre is a ball of iron about the size of the Earth. The layers are drawn far wider than they are." },
        { at: 0.26, when: "A quarter of a second left", title: "Iron does not burn", scale: "In frame: about 1,000 km", text: "Fusing iron takes energy instead of giving it, so the core can no longer hold itself up. Once it reaches about 1.4 times the Sun's mass it falls in on itself, at up to a quarter of the speed of light." },
        { at: 0.34, when: "During the fall", title: "Gamma rays break the nuclei", scale: "In frame: about 100 femtometres", text: "The core is so hot that its light breaks iron nuclei apart. Each iron-56, 26 protons and 30 neutrons, splits into 13 helium nuclei and 4 neutrons, then the helium into single protons and neutrons. Every split uses up energy, so the core falls faster." },
        { at: 0.47, when: "Milliseconds", title: "Protons become neutrons", scale: "In frame: about 100 femtometres", text: "Electrons are squeezed into protons, turning them into neutrons and releasing neutrinos: particles so slight that a light-year of lead would stop only about half of them." },
        { at: 0.55, when: "The bounce", title: "The core stops, and rebounds", scale: "In frame: about 300 km", text: "At the density of an atomic nucleus the core can fall no further. It stiffens and rebounds, sending out a shock wave. Over the next ten seconds neutrinos carry away 99% of the energy released, and some of them push the shock on." },
        { at: 0.66, when: "Hours to weeks later", title: "The explosion", scale: "In frame: a few light-years", text: "The shock reaches the surface and blows the star apart. For weeks it can outshine its whole galaxy, and the gas it throws off carries the elements it made, iron, oxygen, calcium, out into space to make new stars and planets." },
        { at: 0.74, when: "What is left", title: "A neutron star", scale: "In frame: about 100 km", text: "More mass than the Sun, in a ball about 20 kilometres across, spinning many times a second. A teaspoon of it would weigh billions of tonnes." },
        { at: 0.82, when: "Inside it", title: "Quarks", scale: "In frame: about 5 femtometres", text: "Each neutron is three quarks held together by the strong force, carried by gluons. Pull two quarks apart and the field between them only stretches; at a neutron star's centre they may be pressed so close that they move freely." },
        { at: 0.91, when: "A hypothesis", title: "Strange matter", scale: "In frame: about 5 femtometres", text: "Arnold Bodmer in 1971, and Edward Witten in 1984, suggested that a mix of up, down and strange quarks might be more stable than ordinary nuclei. If so, some neutron stars may be strange stars all through. None has been found yet." },
      ]}
    />

    <Section id="projects" title="Projects" lede="Hackathon builds and things I made because I wanted them.">
      <Entry title="Cardboard Cockpit" href="https://devpost.com/software/wad" role="Hack the North" period="2026" tags="Godot, OpenCV, ArUco, BLE, WebSockets">
        <p>
          A flight simulator you fly with a cardboard cockpit, printed markers and a webcam. I built most
          of the Godot sim: the map, weapons, HUD, landing, tutorial, and the Bluetooth badge controls.
        </p>
        <Cockpit slot="figure" />
      </Entry>
      <Entry title="Daedalus" href="https://devpost.com/software/glebber-stometric" role="JAMHacks 10, Best Non-GenAI Hack" period="2026" tags="TypeScript, Three.js, MediaPipe">
        <p>3D sculpting with your hands in the air, tracked through a webcam. We built it in under 24 hours.</p>
        <Daedalus slot="figure" />
      </Entry>
      <Entry title="Drift" href="https://chromewebstore.google.com/detail/drift/agihdlojchhjpflceecmfknffggofdhf" role="Chrome extension, Featured on the Web Store" period="2026" tags="JavaScript, Chrome Extensions API">
        <p>
          While ChatGPT, Claude or Gemini is thinking, Drift offers you a focused window for whatever you'd
          scroll anyway, then brings you back the moment the answer lands.
        </p>
        <Drift slot="figure" />
      </Entry>
      <Entry title="Worldline Engine" href="https://github.com/fireheartjerry/worldline-engine" role="Simulation" period="2026" tags="C++, raylib, CMake">
        <p>
          A seeded universe simulator in C++. The same seed always produces the same universe, down to
          the last particle, so any run can be saved, replayed and scrubbed through. The cover of this
          page grows from a seed the same way.
        </p>
        <Worldline slot="figure" />
      </Entry>

      <div class="also">
        <h3>Also</h3>
        <ul data-reveal="rows">
          <li>
            <a class="ln" href="https://github.com/fireheartjerry/porchlight" target="_blank" rel="noopener">Porchlight</a>
            <p>
              A multi-agent aid dispatcher on Strands Agents and Bedrock AgentCore. Deterministic safety,
              money and confidence gates send sensitive requests to a person, as decision cards that persist.
            </p>
            <span>Python, React, Strands Agents, Bedrock AgentCore</span>
          </li>
          <li>
            <a class="ln" href="https://github.com/fireheartjerry/PolyTwist" target="_blank" rel="noopener">PolyTwist</a>
            <p>
              A deterministic engine for twisty puzzles it has never seen: exact rational geometry,
              WebGL2 and CPU rendering, and benchmarks across 16 task families.
            </p>
            <span>JavaScript, Node.js, WebGL2</span>
          </li>
        </ul>
      </div>
    </Section>

    <Interlude
      kind="quasar"
      name="A quasar, past a nebula"
      caption="Far off, gas falling into the black hole at the centre of a galaxy, heated until it outshines every star around it, with two jets thrown out at close to the speed of light. Near, in our own galaxy, a cloud of hydrogen glowing red and oxygen glowing teal, with lanes of dust across it."
    />

    <Section id="record" title="Record" lede="Scholarships, papers and contest results.">
      <div class="record-grid">
        <dl class="record" data-reveal="rows">
          {record.map((r) => (
            <div>
              <dt>{r.what}</dt>
              <dd>{r.detail}</dd>
              {r.when && <dd class="when cm">{r.when}</dd>}
            </div>
          ))}
          <div class="reach">
            <dt>Elsewhere</dt>
            <dd>
              9,000+ followers on <a class="ln" href="https://www.linkedin.com/in/fireheartjerry/" target="_blank" rel="noopener">LinkedIn</a>.
              First on Tokenboard's worldwide ranking in August 2026. Over 100 billion tokens used with coding agents to date.
            </dd>
          </div>
        </dl>
        <Contests />
      </div>
    </Section>

    <Sequence
      scene="deeptime"
      name="Deep time: the rest of the universe's life"
      length={10}
      steps={[
        { at: 0, when: "Now: 13.8 billion years", title: "The age of stars", scale: "In frame: about a billion light-years", text: "The universe today: hundreds of billions of galaxies, most of them still making stars. By the clock this sequence keeps, we live at the very beginning." },
        { at: 0.14, when: "100 trillion years", title: "The last stars go out", scale: "In frame: about a billion light-years", text: "The gas for new stars runs out. The longest-lived stars, small red dwarfs, burn for trillions of years, and then they too go out, and the galaxies go dark." },
        { at: 0.28, when: "10¹⁵ to 10⁴⁰ years", title: "Cinders", scale: "In frame: about a light-year", text: "What is left are the remains of stars: white dwarfs cooling to black, neutron stars, black holes. If protons decay at all, experiments show they last more than 10³⁴ years; if they do, these cinders slowly fall apart too." },
        { at: 0.44, when: "Up to 10¹⁰⁰ years", title: "Black holes evaporate", scale: "In frame: a black hole, shrinking", text: "Black holes outlast everything else. Quantum effects at the edge of each make it glow very faintly and lose mass, a little faster the smaller it gets. One the mass of the Sun takes about 10⁶⁷ years; the largest, about 10¹⁰⁰. Each ends in a flash." },
        { at: 0.6, when: "After 10¹⁰⁰ years", title: "Heat death", scale: "In frame: empty space", text: "Then nothing is left that can happen. What energy remains is spread evenly through space, about 10⁻³⁰ degrees above absolute zero, and with no differences left there is nothing to drive any change. Physicists call this the heat death." },
        { at: 0.76, when: "At every moment, everywhere", title: "Empty space is not empty", scale: "In frame: much smaller than an atom", text: "Even a perfect vacuum is never still: quantum fields shake at their lowest energy, and pairs of particles and antiparticles appear and vanish too quickly to catch. At the smallest scales, near 10⁻³⁵ metres, space itself may be a foam." },
        { at: 0.9, when: "Possible, very unlikely", title: "A false vacuum", scale: "In frame: much smaller than an atom", text: "The Higgs field may not be in its lowest state. If a bubble of a lower state ever formed, it would spread at nearly the speed of light, and inside it the laws of physics would be different. Calculations put the expected wait far beyond the age of the universe." },
      ]}
    />
  </main>

  <Footer />
  <Palette />

  <script>
    import "../scripts/page";
    import "../scripts/figures";
  </script>
</Base>

<style>
  .papers {
    margin-top: 22px;
    display: grid;
    gap: 14px;
    font-size: 15px;
  }
  .papers a {
    color: var(--ink);
    padding-block: 6px;
  }
  .papers span {
    display: block;
    margin-top: 2px;
    font-size: 13.5px;
    color: var(--ink-3);
  }
  .stack {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }
  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 20px;
    align-items: stretch;
  }
  /* A default-width plate inside a full-width figure row sits on the figure column. */
  .solo {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: clamp(32px, 6vw, 96px);
  }
  .solo > :global(*) {
    grid-column: 2;
  }
  @media (max-width: 980px) {
    .pair {
      grid-template-columns: minmax(0, 1fr);
    }
    .solo {
      display: block;
    }
  }

  /* Smaller projects: two columns of plain text under the figures. */
  .also {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: clamp(32px, 6vw, 96px);
    padding-block: clamp(40px, 5.5vw, 80px) 0;
    border-top: 1px solid var(--hair);
  }
  .also h3 {
    font-size: 21px;
    line-height: 1.25;
    letter-spacing: -0.012em;
  }
  .also ul {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 28px clamp(24px, 4vw, 56px);
  }
  .also li > a {
    font-size: 17px;
    padding-block: 8px;
  }
  .also p {
    margin-top: 8px;
    font-size: 15px;
    color: var(--ink-2);
  }
  .also span {
    display: block;
    margin-top: 10px;
    font-size: 13.5px;
    color: var(--ink-3);
  }
  @media (max-width: 880px) {
    .also {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 20px;
    }
  }
  @media (max-width: 560px) {
    .also ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .record-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: clamp(32px, 6vw, 96px);
    align-items: start;
    border-top: 1px solid var(--hair);
    padding-top: clamp(32px, 5vw, 64px);
  }
  .record {
    position: sticky;
    top: 96px;
    margin: 0;
  }
  .record > div {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 16px;
    padding-block: 13px;
  }
  /* The rule under each row is a line that can be drawn. */
  .record > div::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--hair);
    transform: scaleX(var(--rule, 1));
    transform-origin: left;
  }
  .record > div:first-child {
    padding-top: 0;
  }
  .record dt {
    grid-column: 1;
    font-size: 17px;
  }
  .record dd {
    grid-column: 1;
    font-size: 15px;
    color: var(--ink-3);
  }
  .record .when {
    grid-column: 2;
    grid-row: 1;
    font-size: 15px;
    color: var(--ink-3);
  }
  .record .reach::after {
    content: none;
  }
  .record .reach dd :global(a) {
    padding-block: 6px;
  }
  @media (max-width: 880px) {
    .record-grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 36px;
    }
    .record {
      position: static;
    }
  }
</style>
