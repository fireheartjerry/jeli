---
// Rendered to public/og.jpg by tools/og.mjs; not linked from anywhere.
import Base from "../layouts/Base.astro";
---

<Base title="og" noindex theme="dark">
  <div class="og" data-night>
    <img src="/cover.webp" alt="" />
    <div class="copy">
      <p class="name">Jerry Li</p>
      <p class="line">Computer science at Waterloo. Schulich Leader, sole author at NeurIPS 2026 workshops, founder of TopsOJ, co-founder of Waterloo Defence.</p>
      <p class="url">yuzeli.ca</p>
    </div>
  </div>
</Base>

<style>
  .og { position: relative; width: 1200px; height: 630px; overflow: hidden; background: var(--paper); color: var(--ink); }
  img { position: absolute; right: -150px; top: -70px; width: 1230px; height: 770px; object-fit: cover; -webkit-mask-image: linear-gradient(90deg, transparent 8%, #000 52%); mask-image: linear-gradient(90deg, transparent 8%, #000 52%); }
  .copy { position: absolute; left: 72px; top: 0; bottom: 0; display: flex; flex-direction: column; justify-content: center; width: 560px; }
  .name { font-size: 132px; font-weight: 500; letter-spacing: -0.048em; line-height: 0.9; }
  .line { margin-top: 34px; font-size: 27px; line-height: 1.36; color: var(--ink-2); }
  .url { margin-top: 30px; font-size: 22px; color: var(--accent); }
</style>
